# Template only. Copy to .env and fill locally; never commit real values.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000
Milestone__Enabled=true
ConnectionStrings__Telemedicina=Host=YOUR_HOST;Port=5432;Database=YOUR_DATABASE;Username=YOUR_USER;Password=SET_PRIVATELY;SSL Mode=VerifyFull
Milestone__PortalOrigin=http://localhost:3000
Milestone__MailboxKey=GENERATE_A_RANDOM_PRIVATE_KEY
Milestone__AdmissionEmail=admission@example.invalid
Milestone__AdmissionPassword=SET_A_PRIVATE_PASSWORD_WITH_12_OR_MORE_CHARACTERS
# Use smtp to enable delivery after configuring private credentials.
Mail__Mode=development
# Keep true normally. Development only: false works around unavailable revocation status
# on macOS; chain trust, expiry and hostname validation remain enabled.
Mail__CheckCertificateRevocation=true
Mail__Host=smtp.gmail.com
Mail__Port=587
Mail__Username=sender@example.invalid
Mail__Sender=sender@example.invalid
Mail__Password=SET_PRIVATELY
Mail__PayloadKey=GENERATE_32_RANDOM_BYTES_AS_BASE64
