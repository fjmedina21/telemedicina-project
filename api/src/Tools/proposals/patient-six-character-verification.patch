+    DELETE FROM dev_mailbox WHERE purpose='verify';
+    UPDATE email_outbox SET state='Superseded',payload_cipher=''
+        WHERE kind='auth:verify' AND state='Queued';
+    INSERT INTO schema_versions(version) VALUES(4);
+END IF;
+END $migration$;
