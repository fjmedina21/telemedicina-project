+++ b/api/src/PRIMER_HITO.md
@@ -0,0 +1,165 @@
+# Primer hito usable — propuesta para revisión
+
+Estado: parche propuesto, no integrado, no compilado ni ejecutado.
+Responsable backend: backend_mobile. Flutter: ambos colaboradores. Portal: asignar responsable por PR.
+Rutas del cambio: api/src/, app/src/ y portalweb/src/. Sin despliegue ni cambios remotos automáticos.
+
+## Alcance y decisiones
+
+Incremento local con datos sintéticos: registro/verificación, login, recuperación, sesiones revocables,
+perfil, catálogo y disponibilidad, solicitud, revisión manual de cobertura, confirmación, cancelación,
+reprogramación e historial. Portal protegido de admisión con MFA TOTP y consulta de auditoría.
+No activa video, consentimiento, expediente clínico, pagos ni recetas.
+
+PostgreSQL es la base indicada por el usuario. Credenciales solo por configuración del proceso:
+ConnectionStrings__Telemedicina. El parche nunca contiene la URL privada ni contraseñas.
+Se acepta una URI postgres:// o una cadena Npgsql. La URI exige TLS; para validar certificado y
+hostname usar cadena Npgsql con SSL Mode=VerifyFull y Root Certificate según la CA del proveedor.
+Ver https://www.npgsql.org/doc/security.html.
+
+La migración usa el esquema telemedicina_m1; conserva las tablas de public.
+Requiere btree_gist para restricciones de solapamiento. No asume permisos ni disponibilidad de esa
+extensión en Aiven: comprobarlos antes de aplicar. No se inspeccionó aún el esquema remoto.
+Esquema y seeds solo se ejecutan por comandos explícitos; nunca al iniciar normalmente.
+
+El servicio y profesional sembrados son demostraciones, no oferta clínica aprobada.
+No se prometen tarifas, cobertura, atención particular ni políticas clínicas.
+En este entorno sintético se permite cancelar/reprogramar antes del inicio.
+Las políticas de anticipación y cancelación configurables de producción siguen pendientes.
+La cobertura aprobada requiere referencia de evidencia y vigencia hasta el final de la cita.
+Denegar cobertura mantiene la cita pendiente, sin convertirla automáticamente a particular.
+Reprogramar invalida la revisión anterior y vuelve a ManualReview.
+
+## Contrato propuesto
+
+Todas las rutas están bajo /api/v1. Éxito: {success,status,detail,data}.
+Errores operativos: {status,title,code,traceId}; conservar códigos HTTP 400/401/403/404/409/429.
+La validación automática de DTO usa ValidationProblemDetails de ASP.NET Core.
+UUID públicos. Fechas UTC en API/DB; clientes muestran America/Santo_Domingo.
+
+| Método / ruta | Acceso | Efecto |
+|---|---|---|
+| POST /auth/register | Público limitado | Crea cuenta Patient sin verificar; respuesta genérica 202 |
+| POST /auth/verify | Token de un uso | Verifica cuenta |
+| POST /auth/login | Credenciales; MFA para Admission | Sesión opaca con acceso 30 min y límite absoluto 8 h |
+| POST /auth/refresh | Refresh válido | Rota acceso/refresh y revoca sesión anterior |
+| POST /auth/logout | Autenticado | Revoca acceso y refresh de esa sesión |
+| POST /auth/password/forgot | Público limitado | Respuesta genérica 202 |
+| POST /auth/password/reset | Token de un uso | Cambia contraseña y revoca sesiones |
+| GET /auth/me | Autenticado | Identidad y rol del servidor |
+| GET /auth/dev-mailbox?email=...&purpose=verify/reset | Clave de desarrollador | Solo pruebas sintéticas |
+| GET/PATCH /patients/me | Patient | Perfil con versión optimista y datos SelfDeclared |
+| GET /specialties, /services, /practitioners | Autenticado | Catálogo activo |
+| GET /availability?serviceId=UUID | Autenticado | Horarios futuros libres; rango máximo 31 días |
+| POST /appointments | Patient | Solicita con Idempotency-Key UUID |
+| GET /appointments/me | Patient | Sus citas |
+| GET /appointments/{id}, /appointments/{id}/history | Dueño o Admission | Detalle e historial |
+| POST /appointments/{id}/cancel | Dueño | Cancela con versión y libera horario |
+| POST /appointments/{id}/reschedule | Dueño | Nuevo horario y versión; conserva historial |
+| GET /admin/work-queue | Admission | Citas persistentes |
+| PATCH /admin/appointments/{id}/validation | Admission | Evidencia, vigencia, actor y versión |
+| POST /admin/slots | Admission | Crea horario sin solapamientos |
+| PATCH /admin/slots/{id}/block | Admission | Bloquea libre; rechaza si hay reserva |
+| PATCH /admin/users/{id}/active | Admission | Suspende/reactiva Patient; revoca sesiones al suspender |
+| GET /admin/audit-events?after=0 | Admission | Página de 100 eventos sin contenido clínico |
+
+Los estados de cita y cobertura se mantienen independientes.
+El perfil no permite editar identificadores legales; solo datos de contacto y autodeclaraciones.
+Idempotency-Key conserva resultado ante reintentos y devuelve 409 si cambia el payload.
+La exclusión PostgreSQL evita reservas concurrentes solapadas incluso desde otros procesos.
+Historial conserva horarios, estados y referencias de cobertura previos; no borra notas clínicas.
+La auditoría e historial bloquean UPDATE/DELETE/TRUNCATE por triggers. El dueño de la base puede
+alterar objetos: requiere rol de aplicación sin DDL y controles externos antes de producción.
+
+## Configuración local después de aprobar el parche
+
+Variables de entorno privadas, sin valores por defecto:
+- ASPNETCORE_ENVIRONMENT=Development
+- Milestone__Enabled=true
+- ConnectionStrings__Telemedicina: conexión privada PostgreSQL
+- Milestone__MailboxKey: clave aleatoria de desarrollo
+- Milestone__AdmissionEmail: cuenta sintética de admisión
+- Milestone__AdmissionPassword: contraseña privada de al menos 12 caracteres
+- Milestone__AdmissionTotpSecret: secreto Base32 aleatorio de al menos 32 caracteres,
+  provisionado en un autenticador por canal seguro; no enviarlo a logs ni al navegador.
+
+El buzón de desarrollo requiere X-Dev-Mailbox-Key. No es correo real ni prueba de identidad
+apta para producción. No incorporar esa clave a Flutter ni a variables NEXT_PUBLIC.
+Los endpoints del hito están desactivados fuera de Development o sin Milestone__Enabled.
+Registro público solo crea Patient; el rol Admission se provisiona explícitamente por seed.
+
+Compilar:
+dotnet build api/src/Telemedicina.Api/Telemedicina.Api.csproj
+
+Aplicar migración revisada:
+dotnet run --project api/src/Telemedicina.Api/Telemedicina.Api.csproj -- --migrate
+
+Sembrar únicamente en base sintética:
+dotnet run --project api/src/Telemedicina.Api/Telemedicina.Api.csproj -- --seed-synthetic
+
+Iniciar:
+dotnet run --project api/src/Telemedicina.Api/Telemedicina.Api.csproj
+El proyecto requiere runtime .NET 9; el SDK 10 instalado no lo sustituye.
+DOTNET_ROLL_FORWARD=Major permite comprobación local temporal en .NET 10; no se cambia el target.
+
+Portal (desde portalweb/src):
+npm ci
+npm run build
+npm run dev
+
+Portal usa cookies HttpOnly SameSite=Strict mediante /api/backend, sin tokens en localStorage.
+API_INTERNAL_URL es configuración de servidor, no contiene credenciales de base de datos.
+Milestone__PortalOrigin debe coincidir exactamente con el origen del portal (por defecto http://localhost:3000).
+El cliente envía cabecera anti-CSRF; se rechazan otros orígenes.
+Las cookies usan Secure cuando la solicitud API es HTTPS; producción requiere configurar forwarding
+y TLS correctamente antes de habilitar este incremento fuera del entorno local.
+
+Flutter (desde app/src):
+flutter pub get
+flutter analyze
+flutter test
+flutter run -d macos --dart-define=API_BASE_URL=http://127.0.0.1:5000/api/v1
+Android Emulator: API_BASE_URL=http://10.0.2.2:5000/api/v1.
+Dispositivos físicos: URL HTTPS alcanzable. No se habilitan excepciones HTTP de release.
+Regenerar y revisar pubspec.lock al restaurar la dependencia http.
+Los tokens solo se mantienen en memoria; reiniciar requiere login.
+La ruta inicial nueva no enlaza los prototipos de video/documentos.
+
+## Validación pendiente
+
+Pruebas Flutter incluidas: acceso inicial, preservación de 409, renovación con la misma clave
+de idempotencia y borrado de sesión incluso ante fallo de red.
+
+Pruebas HTTP reales, contra una API local que apunte a una base de prueba separada:
+MILESTONE_TEST_SYNTHETIC=1 python3 api/src/Telemedicina.Tests/milestone_e2e.py
+Requieren las variables privadas del buzón y la cuenta Admission indicadas arriba.
+Generan solo datos sintéticos identificables con example.invalid, no borran objetos ni registros.
+No ejecutarlas contra una base con datos reales.
+Cubren permisos, acceso cruzado, 404, idempotencia, concurrencia, revisión/versiones,
+historial, reprogramación, cancelación/liberación, bloqueo y revocación.
+
+Falta ejecutar tras aprobación: restauración, builds, análisis, pruebas HTTP y UI en macOS,
+Android/iOS y navegador; reiniciar API y confirmar persistencia; probar recuperación y MFA negativa.
+La CI raíz requiere después su PR autorizado: incorporar portal, ejecutar pruebas de consola .NET
+con dotnet run y alinear runtime net9.0; no se cambia .github fuera de las tres áreas asignadas.
+
+## Recorrido de aceptación
+
+1. Crear/verificar dos pacientes sintéticos y completar sus perfiles.
+2. Ver catálogo y horarios de demostración; solicitar sin afirmar cobertura.
+3. Admisión inicia con TOTP, revisa evidencia y confirma cobertura vigente.
+4. Paciente actualiza y observa los mismos estados persistidos.
+5. Reprogramar vuelve a revisión; cancelar libera horario y conserva historial.
+6. Reservas concurrentes: una gana y la otra recibe 409.
+7. Paciente B no lee la cita de A; paciente no puede usar endpoints de admisión.
+8. Reiniciar API conserva registros. Salir/reset/suspender invalida sesiones.
+9. Historial y auditoría muestran actor y cambios sin contraseñas ni tokens.
+10. Registrar resultado real de cada prueba antes de declarar el hito completo.
+
+## Pendientes para cumplimiento total de specs
+
+Proveedor de identidad/correo y recuperación real; MFA de personal con gestión de enrolamiento;
+configuración clínica aprobada de servicios; políticas configurables de agenda, cancelación y feriados;
+gestión de servicios/profesionales; resolución manual de duplicados; controles de retención y auditoría
+con rol mínimo; notificaciones/outbox reales y CI integral. Dependientes completos son P1.
+Estos pendientes no deben presentarse como implementados por el flujo sintético.
diff --git a/api/src/Telemedicina.Api/Milestone/001_initial.sql b/api/src/Telemedicina.Api/Milestone/001_initial.sql
new file mode 100644
--- /dev/null
+++ b/api/src/Telemedicina.Api/Milestone/001_initial.sql
@@ -0,0 +1,85 @@
+-- Review and apply explicitly using --migrate. Never run automatically on API startup.
+-- Dedicated schema; no changes to existing public tables. Synthetic data only.
+CREATE EXTENSION IF NOT EXISTS btree_gist;
+CREATE SCHEMA IF NOT EXISTS telemedicina_m1;
+SET LOCAL search_path TO telemedicina_m1, public;
+CREATE TABLE IF NOT EXISTS schema_versions(version integer PRIMARY KEY, applied_at timestamptz NOT NULL DEFAULT now());
+DO $migration$
+BEGIN
+IF NOT EXISTS (SELECT 1 FROM schema_versions WHERE version=1) THEN
+CREATE TABLE users (
+    id text PRIMARY KEY, email text NOT NULL, password_hash text NOT NULL,
+    role text NOT NULL CHECK(role IN ('Patient','Admission')), verified boolean NOT NULL DEFAULT false,
+    active boolean NOT NULL DEFAULT true, totp_secret text, last_totp_step bigint NOT NULL DEFAULT -1,
+    failed_logins integer NOT NULL DEFAULT 0, locked_until bigint NOT NULL DEFAULT 0);
+CREATE UNIQUE INDEX users_email ON users(lower(email));
+CREATE TABLE profiles(user_id text PRIMARY KEY REFERENCES users(id), body text NOT NULL, version integer NOT NULL DEFAULT 1, updated_at timestamptz NOT NULL DEFAULT now());
+CREATE TABLE sessions(
+    id text PRIMARY KEY, user_id text NOT NULL REFERENCES users(id),
+    access_hash text NOT NULL UNIQUE, refresh_hash text NOT NULL UNIQUE,
+    access_expires bigint NOT NULL, expires bigint NOT NULL, revoked boolean NOT NULL DEFAULT false);
+CREATE TABLE challenges(
+    token_hash text PRIMARY KEY, user_id text NOT NULL REFERENCES users(id),
+    purpose text NOT NULL, expires bigint NOT NULL, used boolean NOT NULL DEFAULT false);
+CREATE TABLE dev_mailbox(
+    user_id text NOT NULL REFERENCES users(id), purpose text NOT NULL, token text NOT NULL,
+    expires bigint NOT NULL, PRIMARY KEY(user_id,purpose));
+CREATE TABLE services(
+    id text PRIMARY KEY, specialty text NOT NULL, name text NOT NULL,
+    duration integer NOT NULL CHECK(duration BETWEEN 5 AND 240), active boolean NOT NULL DEFAULT true);
+CREATE TABLE practitioners(id text PRIMARY KEY, name text NOT NULL, active boolean NOT NULL DEFAULT true);
+CREATE TABLE slots(
+    id text PRIMARY KEY, service_id text NOT NULL REFERENCES services(id),
+    practitioner_id text NOT NULL REFERENCES practitioners(id),
+    start_utc timestamptz NOT NULL, end_utc timestamptz NOT NULL, blocked boolean NOT NULL DEFAULT false,
+    CHECK(start_utc < end_utc),
+    UNIQUE(id,practitioner_id,start_utc,end_utc),
+    EXCLUDE USING gist(practitioner_id WITH =, tstzrange(start_utc,end_utc,'[)') WITH &&));
+CREATE TABLE appointments(
+    id text PRIMARY KEY, user_id text NOT NULL REFERENCES users(id),
+    slot_id text NOT NULL, practitioner_id text NOT NULL,
+    start_utc timestamptz NOT NULL, end_utc timestamptz NOT NULL,
+    FOREIGN KEY(slot_id,practitioner_id,start_utc,end_utc) REFERENCES slots(id,practitioner_id,start_utc,end_utc),
+    status text NOT NULL CHECK(status IN ('PendingValidation','Confirmed','Cancelled','Rejected')),
+    coverage text NOT NULL CHECK(coverage IN ('Pending','ManualReview','Approved','Denied','Expired')),
+    insurer text NOT NULL, member_last4 text NOT NULL CHECK(member_last4 ~ '^[0-9]{4}$'),
+    evidence text, coverage_valid_until timestamptz, reviewed_by text REFERENCES users(id), reviewed_at timestamptz,
+    version integer NOT NULL DEFAULT 1,
+    EXCLUDE USING gist(practitioner_id WITH =, tstzrange(start_utc,end_utc,'[)') WITH &&)
+        WHERE(status IN ('PendingValidation','Confirmed')));
+CREATE TABLE appointment_history(
+    sequence bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
+    appointment_id text NOT NULL REFERENCES appointments(id), old_slot_id text, new_slot_id text NOT NULL,
+    old_status text, new_status text NOT NULL, old_coverage text, new_coverage text NOT NULL,
+    old_evidence text, new_evidence text, old_valid_until timestamptz, new_valid_until timestamptz,
+    version integer NOT NULL, actor_id text NOT NULL, occurred_at timestamptz NOT NULL DEFAULT now());
+CREATE FUNCTION track_appointment() RETURNS trigger LANGUAGE plpgsql AS $history$
+BEGIN
+    INSERT INTO appointment_history(appointment_id,old_slot_id,new_slot_id,old_status,new_status,
+        old_coverage,new_coverage,old_evidence,new_evidence,old_valid_until,new_valid_until,version,actor_id)
+    VALUES(NEW.id,CASE WHEN TG_OP='UPDATE' THEN OLD.slot_id ELSE NULL END,NEW.slot_id,
+        CASE WHEN TG_OP='UPDATE' THEN OLD.status ELSE NULL END,NEW.status,
+        CASE WHEN TG_OP='UPDATE' THEN OLD.coverage ELSE NULL END,NEW.coverage,
+        CASE WHEN TG_OP='UPDATE' THEN OLD.evidence ELSE NULL END,NEW.evidence,
+        CASE WHEN TG_OP='UPDATE' THEN OLD.coverage_valid_until ELSE NULL END,NEW.coverage_valid_until,NEW.version,
+        coalesce(current_setting('telemedicina.actor',true),NEW.user_id));
+    RETURN NEW;
+END $history$;
+CREATE TRIGGER appointment_history_written AFTER INSERT OR UPDATE ON appointments
+    FOR EACH ROW EXECUTE FUNCTION track_appointment();
+CREATE TABLE idempotency(
+    user_id text NOT NULL REFERENCES users(id), key text NOT NULL, request_hash text NOT NULL,
+    response text NOT NULL, PRIMARY KEY(user_id,key));
+CREATE TABLE audit(
+    sequence bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY, id text NOT NULL UNIQUE,
+    actor_id text NOT NULL, action text NOT NULL, resource_id text NOT NULL,
+    occurred_at timestamptz NOT NULL DEFAULT now(), trace_id text NOT NULL);
+CREATE FUNCTION protect_audit() RETURNS trigger LANGUAGE plpgsql AS $body$
+BEGIN RAISE EXCEPTION 'Audit events are append only'; END $body$;
+CREATE TRIGGER audit_no_mutation BEFORE UPDATE OR DELETE OR TRUNCATE ON audit
+    FOR EACH STATEMENT EXECUTE FUNCTION protect_audit();
+CREATE TRIGGER history_no_mutation BEFORE UPDATE OR DELETE OR TRUNCATE ON appointment_history
+    FOR EACH STATEMENT EXECUTE FUNCTION protect_audit();
+INSERT INTO schema_versions(version) VALUES(1);
+END IF;
+END $migration$;
diff --git a/api/src/Telemedicina.Api/Milestone/AuthController.cs b/api/src/Telemedicina.Api/Milestone/AuthController.cs
new file mode 100644
--- /dev/null
+++ b/api/src/Telemedicina.Api/Milestone/AuthController.cs
@@ -0,0 +1,179 @@
+using Microsoft.AspNetCore.Authorization;
+using Microsoft.AspNetCore.Mvc;
+using Microsoft.AspNetCore.RateLimiting;
+using Npgsql;
+using static Telemedicina.Api.Milestone.Database;
+using static Telemedicina.Api.Milestone.Security;
+
+namespace Telemedicina.Api.Milestone;
+
+[ApiController, Route("api/v1/auth"), EnableRateLimiting("auth")]
+public sealed class AuthController(Database database, IConfiguration configuration) : ControllerBase
+{
+    private IActionResult OkData(object data) => Ok(new {success=true,status=200,detail="OK",data});
+    private IActionResult Failure(int status,string code) => StatusCode(status,new {
+        status,title="No se pudo completar la operación",code,traceId=HttpContext.TraceIdentifier});
+    private static readonly string DummyHash = Password(NewToken());
+
+    [HttpPost("register")]
+    public IActionResult Register(RegisterRequest request)
+    {
+        using var c=database.Open(); using var t=c.BeginTransaction();
+        var id=Guid.NewGuid().ToString();
+        var inserted=Execute(c,t,"""
+            INSERT INTO users(id,email,password_hash,role) VALUES(@id,@email,@hash,'Patient')
+            ON CONFLICT DO NOTHING
+            """,("id",id),("email",request.Email.Trim().ToLowerInvariant()),("hash",Password(request.Password)));
+        if(inserted>0) {
+            Challenge(c,t,id,"verify"); Audit(c,t,id,"account.registered",id,HttpContext.TraceIdentifier);
+        }
+        t.Commit();
+        return Accepted(new {success=true,status=202,detail="Si corresponde, revise el mensaje de verificación."});
+    }
+    private void Challenge(NpgsqlConnection c,NpgsqlTransaction t,string user,string purpose)
+    {
+        var token=NewToken(); var expires=Now+900;
+        Execute(c,t,"UPDATE challenges SET used=true WHERE user_id=@u AND purpose=@p",
+            ("u",user),("p",purpose));
+        Execute(c,t,"INSERT INTO challenges(token_hash,user_id,purpose,expires) VALUES(@h,@u,@p,@e)",
+            ("h",Hash(token)),("u",user),("p",purpose),("e",expires));
+        Execute(c,t,"""
+            INSERT INTO dev_mailbox(user_id,purpose,token,expires) VALUES(@u,@p,@token,@e)
+            ON CONFLICT(user_id,purpose) DO UPDATE SET token=excluded.token,expires=excluded.expires
+            """,("u",user),("p",purpose),("token",token),("e",expires));
+    }
+    [HttpPost("verify")]
+    public IActionResult Verify(TokenRequest request)
+    {
+        using var c=database.Open(); using var t=c.BeginTransaction();
+        var user=Scalar(c,t,"""
+            UPDATE challenges SET used=true WHERE token_hash=@h AND purpose='verify'
+            AND NOT used AND expires>@now RETURNING user_id
+            """,("h",Hash(request.Token)),("now",Now)) as string;
+        if(user is null) return Failure(400,"INVALID_CHALLENGE");
+        Execute(c,t,"UPDATE users SET verified=true WHERE id=@u",("u",user));
+        Execute(c,t,"DELETE FROM dev_mailbox WHERE user_id=@u AND purpose='verify'",("u",user));
+        Audit(c,t,user,"account.verified",user,HttpContext.TraceIdentifier); t.Commit();
+        return OkData(new {verified=true});
+    }
+    [HttpPost("password/forgot")]
+    public IActionResult Forgot(ForgotRequest request)
+    {
+        using var c=database.Open(); using var t=c.BeginTransaction();
+        var user=Scalar(c,t,"SELECT id FROM users WHERE lower(email)=lower(@e) AND active",
+            ("e",request.Email.Trim())) as string;
+        if(user is not null) Challenge(c,t,user,"reset");
+        t.Commit();
+        return Accepted(new {success=true,status=202,detail="Si corresponde, revise el mensaje de recuperación."});
+    }
+    [HttpPost("password/reset")]
+    public IActionResult Reset(ResetRequest request)
+    {
+        using var c=database.Open(); using var t=c.BeginTransaction();
+        var user=Scalar(c,t,"""
+            UPDATE challenges SET used=true WHERE token_hash=@h AND purpose='reset'
+            AND NOT used AND expires>@now RETURNING user_id
+            """,("h",Hash(request.Token)),("now",Now)) as string;
+        if(user is null) return Failure(400,"INVALID_CHALLENGE");
+        Execute(c,t,"UPDATE users SET password_hash=@h,failed_logins=0,locked_until=0 WHERE id=@u",
+            ("h",Password(request.Password)),("u",user));
+        Execute(c,t,"UPDATE sessions SET revoked=true WHERE user_id=@u",("u",user));
+        Execute(c,t,"DELETE FROM dev_mailbox WHERE user_id=@u AND purpose='reset'",("u",user));
+        Audit(c,t,user,"account.password_reset",user,HttpContext.TraceIdentifier); t.Commit();
+        return OkData(new {reset=true});
+    }
+    [HttpGet("dev-mailbox")]
+    public IActionResult Mailbox([FromQuery] string email,[FromQuery] string purpose)
+    {
+        var expected=configuration["Milestone:MailboxKey"];
+        var supplied=Request.Headers["X-Dev-Mailbox-Key"].ToString();
+        if(string.IsNullOrEmpty(expected) || !System.Security.Cryptography.CryptographicOperations.FixedTimeEquals(
+            System.Text.Encoding.UTF8.GetBytes(Hash(expected)),System.Text.Encoding.UTF8.GetBytes(Hash(supplied))))
+            return NotFound();
+        using var c=database.Open();
+        var rows=Rows(c,null,"""
+            SELECT m.token,m.expires FROM dev_mailbox m JOIN users u ON u.id=m.user_id
+            WHERE lower(u.email)=lower(@e) AND m.purpose=@p AND m.expires>@n
+            """,("e",email),("p",purpose),("n",Now));
+        return rows.Count==0 ? NotFound() : OkData(rows[0]);
+    }
+    [HttpPost("login")]
+    public IActionResult Login(LoginRequest request)
+    {
+        using var c=database.Open(); using var t=c.BeginTransaction();
+        var rows=Rows(c,t,"SELECT * FROM users WHERE lower(email)=lower(@e) FOR UPDATE",
+            ("e",request.Email.Trim()));
+        var row=rows.FirstOrDefault();
+        var passwordValid=CheckPassword(row?["password_hash"] as string ?? DummyHash,request.Password);
+        long? step=null;
+        if(row is not null && (string)row["role"]! == "Admission")
+            step=TotpStep((string?)row["totp_secret"] ?? "",request.Otp);
+        var valid=row is not null && passwordValid && (bool)row["active"]! && (bool)row["verified"]!
+            && (long)row["locked_until"]!<=Now &&
+            ((string)row["role"]! != "Admission" || (step.HasValue && step.Value>(long)row["last_totp_step"]!));
+        if(!valid) {
+            if(row is not null) {
+                Execute(c,t,"""
+                    UPDATE users SET failed_logins=failed_logins+1,
+                    locked_until=CASE WHEN failed_logins>=4 THEN @until ELSE locked_until END WHERE id=@u
+                    """,("until",Now+300),("u",row["id"]));
+                Audit(c,t,(string)row["id"]!,"account.login_denied",(string)row["id"]!,HttpContext.TraceIdentifier);
+            }
+            t.Commit(); return Failure(401,"INVALID_CREDENTIALS");
+        }
+        Execute(c,t,"UPDATE users SET failed_logins=0,locked_until=0,last_totp_step=@step WHERE id=@u",
+            ("step",step ?? -1),("u",row!["id"]));
+        var result=CreateSession(c,t,(string)row["id"]!,(string)row["role"]!);
+        Audit(c,t,(string)row["id"]!,"session.created",(string)row["id"]!,HttpContext.TraceIdentifier);
+        t.Commit(); return OkData(result);
+    }
+    private object CreateSession(NpgsqlConnection c,NpgsqlTransaction t,string user,string role,long? absoluteExpiry=null)
+    {
+        var access=NewToken(); var refresh=NewToken(); var expires=absoluteExpiry ?? Now+28800;
+        Execute(c,t,"""
+            INSERT INTO sessions(id,user_id,access_hash,refresh_hash,access_expires,expires)
+            VALUES(@id,@u,@a,@r,@ae,@e)
+            """,("id",Guid.NewGuid().ToString()),("u",user),("a",Hash(access)),("r",Hash(refresh)),
+            ("ae",Now+1800),("e",expires));
+        SetCookies(access,refresh);
+        // Browser client requests cookies; secrets never enter browser storage or response JSON.
+        return Request.Headers["X-Session-Mode"]=="cookie"
+            ? new {userId=user,role} : (object)new {userId=user,role,accessToken=access,refreshToken=refresh,expiresIn=1800};
+    }
+    private void SetCookies(string access,string refresh)
+    {
+        var options=new CookieOptions {HttpOnly=true,Secure=Request.IsHttps,SameSite=SameSiteMode.Strict,
+            Path="/",MaxAge=TimeSpan.FromHours(8)};
+        Response.Cookies.Append("tm_access",access,options);
+        Response.Cookies.Append("tm_refresh",refresh,options);
+    }
+    [HttpPost("refresh")]
+    public IActionResult Refresh(RefreshRequest request)
+    {
+        var token=request.RefreshToken ?? Request.Cookies["tm_refresh"];
+        if(string.IsNullOrEmpty(token)) return Failure(401,"SESSION_REQUIRED");
+        using var c=database.Open(); using var t=c.BeginTransaction();
+        var rows=Rows(c,t,"""
+            SELECT s.id,s.user_id,s.expires,u.role FROM sessions s JOIN users u ON u.id=s.user_id
+            WHERE s.refresh_hash=@h AND NOT s.revoked AND s.expires>@now AND u.active AND u.verified
+            FOR UPDATE OF s
+            """,("h",Hash(token)),("now",Now));
+        if(rows.Count==0) return Failure(401,"SESSION_REQUIRED");
+        var row=rows[0];
+        Execute(c,t,"UPDATE sessions SET revoked=true WHERE id=@id",("id",row["id"]));
+        var result=CreateSession(c,t,(string)row["user_id"]!,(string)row["role"]!,(long)row["expires"]!);
+        t.Commit(); return OkData(result);
+    }
+    [Authorize,HttpGet("me")]
+    public IActionResult Me() => OkData(new {userId=UserId(User),email=User.Identity!.Name,
+        role=User.FindFirst(System.Security.Claims.ClaimTypes.Role)!.Value});
+    [Authorize,HttpPost("logout")]
+    public IActionResult Logout()
+    {
+        using var c=database.Open(); using var t=c.BeginTransaction();
+        Execute(c,t,"UPDATE sessions SET revoked=true WHERE id=@id",("id",User.FindFirst("session_id")!.Value));
+        Audit(c,t,UserId(User),"session.revoked",UserId(User),HttpContext.TraceIdentifier); t.Commit();
+        Response.Cookies.Delete("tm_access"); Response.Cookies.Delete("tm_refresh");
+        return OkData(new {loggedOut=true});
+    }
+}
