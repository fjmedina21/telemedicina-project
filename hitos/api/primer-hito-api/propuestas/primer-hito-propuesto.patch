diff --git a/app/src/lib/features/milestone/milestone_screen.dart b/app/src/lib/features/milestone/milestone_screen.dart
new file mode 100644
--- /dev/null
+++ b/app/src/lib/features/milestone/milestone_screen.dart
@@ -0,0 +1,223 @@
+import 'dart:convert';
+import 'package:flutter/material.dart';
+import '../../core/network/milestone_repository.dart';
+
+String localTime(String value) {
+  final d=DateTime.parse(value).toUtc().subtract(const Duration(hours:4));
+  String p(int n)=>n.toString().padLeft(2,'0');
+  return '${p(d.day)}/${p(d.month)}/${d.year} ${p(d.hour)}:${p(d.minute)} (Santo Domingo)';
+}
+
+class MilestoneScreen extends StatefulWidget {
+  final MilestoneRepository? repository;
+  const MilestoneScreen({super.key,this.repository});
+  @override
+  State<MilestoneScreen> createState()=>_MilestoneScreenState();
+}
+class _MilestoneScreenState extends State<MilestoneScreen> {
+  late final MilestoneRepository api=widget.repository ?? MilestoneRepository();
+  final email=TextEditingController(), password=TextEditingController(), token=TextEditingController();
+  final insurer=TextEditingController(), member=TextEditingController();
+  final profileFields=<String,TextEditingController>{
+    for(final key in ['firstName','lastName','birthDate','phone','address','emergencyName','emergencyPhone',
+      'allergies','medications','conditions']) key:TextEditingController()
+  };
+  bool busy=false, signedIn=false;
+  String mode='login', message='';
+  int tab=0, version=0;
+  List<dynamic> services=[],slots=[],appointments=[];
+  String? serviceId;
+  final keys=<String,String>{};
+
+  @override
+  void dispose() {
+    for(final c in [email,password,token,insurer,member,...profileFields.values]) { c.dispose(); }
+    api.close(); super.dispose();
+  }
+  Future<void> run(Future<void> Function() action) async {
+    if(busy) return;
+    setState(()=>{busy=true,message=''});
+    try { await action(); }
+    catch(e) { if(mounted) setState(()=>message=e.toString()); }
+    finally {
+      if(mounted) setState(() {
+        busy=false; signedIn=api.authenticated;
+        if(!signedIn) {
+          appointments=[]; slots=[]; version=0;
+          for(final c in profileFields.values) { c.clear(); }
+        }
+      });
+    }
+  }
+  Future<void> load() async {
+    final results=await Future.wait([
+      api.request('GET','/patients/me'),api.request('GET','/services'),api.request('GET','/appointments/me')
+    ]);
+    if(!mounted) return;
+    setState(() {
+      final data=results[0] as Map?;
+      version=data?['version'] as int? ?? 0;
+      final profile=data?['profile'] as Map? ?? {};
+      for(final entry in profileFields.entries) {
+        final value=profile[entry.key];
+        entry.value.text=value is List ? value.join(', ') : (value ?? '').toString();
+      }
+      services=results[1] as List; appointments=results[2] as List;
+      serviceId=services.any((s)=>s['id']==serviceId) ? serviceId : services.firstOrNull?['id'] as String?;
+    });
+  }
+  Future<void> authenticate() async {
+    if(mode=='login') { await api.login(email.text.trim(),password.text); await load(); }
+    else if(mode=='register') {
+      await api.request('POST','/auth/register',body:{'email':email.text.trim(),'password':password.text});
+      setState(()=>{mode='verify',message='Revise la verificación en el buzón de desarrollo. No use datos reales.'});
+    } else if(mode=='verify') {
+      await api.request('POST','/auth/verify',body:{'token':token.text.trim()});
+      token.clear(); setState(()=>{mode='login',message='Cuenta verificada. Inicie sesión.'});
+    } else if(mode=='forgot') {
+      await api.request('POST','/auth/password/forgot',body:{'email':email.text.trim()});
+      setState(()=>{mode='reset',message='Si corresponde, revise el buzón de desarrollo.'});
+    } else {
+      await api.request('POST','/auth/password/reset',body:{'token':token.text.trim(),'password':password.text});
+      token.clear(); password.clear(); setState(()=>{mode='login',message='Contraseña actualizada.'});
+    }
+  }
+  Widget field(TextEditingController c,String label,{bool secret=false}) => Padding(
+    padding:const EdgeInsets.symmetric(vertical:6),
+    child:TextField(controller:c,obscureText:secret,enabled:!busy,
+      decoration:InputDecoration(labelText:label,border:const OutlineInputBorder())));
+  Widget action(String label,Future<void> Function() fn) =>
+    FilledButton(onPressed:busy ? null : ()=>run(fn),child:Text(label));
+
+  @override
+  Widget build(BuildContext context) => Scaffold(
+    appBar:AppBar(title:const Text('Telemedicina · Datos sintéticos'),actions:[
+      if(signedIn) IconButton(tooltip:'Actualizar',onPressed:busy?null:()=>run(load),icon:const Icon(Icons.refresh)),
+      if(signedIn) TextButton(onPressed:busy?null:()=>run(() async {
+        try { await api.logout(); } finally {
+          if(mounted) setState(() { signedIn=false; appointments=[]; services=[]; slots=[]; version=0;
+            password.clear(); for(final c in profileFields.values) { c.clear(); } });
+        }
+      }),child:const Text('Salir'))
+    ]),
+    body:Column(children:[
+      if(busy) const LinearProgressIndicator(),
+      if(message.isNotEmpty) Padding(padding:const EdgeInsets.all(12),
+        child:Semantics(liveRegion:true,child:Text(message))),
+      Expanded(child:SingleChildScrollView(padding:const EdgeInsets.all(20),
+        child:Center(child:ConstrainedBox(constraints:const BoxConstraints(maxWidth:700),
+          child:!signedIn ? authForm() : tab==0 ? profileForm() : tab==1 ? catalog() : appointmentList()))))
+    ]),
+    bottomNavigationBar:!signedIn ? null : NavigationBar(selectedIndex:tab,
+      onDestinationSelected:busy?null:(value)=>setState(()=>tab=value),
+      destinations:const [
+        NavigationDestination(icon:Icon(Icons.person),label:'Mi perfil'),
+        NavigationDestination(icon:Icon(Icons.calendar_month),label:'Solicitar cita'),
+        NavigationDestination(icon:Icon(Icons.event_note),label:'Mis citas')
+      ]),
+  );
+  Widget authForm()=>Column(crossAxisAlignment:CrossAxisAlignment.stretch,children:[
+    const Text('Primer hito · Entorno de demostración',style:TextStyle(fontSize:22,fontWeight:FontWeight.bold)),
+    const Text('Las citas y coberturas requieren revisión manual. Este entorno no presta atención clínica.'),
+    if(['login','register','forgot'].contains(mode)) field(email,'Correo electrónico'),
+    if(['login','register','reset'].contains(mode)) field(password,'Contraseña (mínimo 12 caracteres)',secret:true),
+    if(['verify','reset'].contains(mode)) field(token,'Código del mensaje de desarrollo'),
+    action({'login':'Entrar','register':'Crear cuenta','verify':'Verificar cuenta',
+      'forgot':'Solicitar recuperación','reset':'Cambiar contraseña'}[mode]!,authenticate),
+    Wrap(spacing:8,children: [
+      for(final entry in {'login':'Iniciar sesión','register':'Registrarme','verify':'Verificar',
+        'forgot':'Recuperar acceso'}.entries)
+        TextButton(onPressed:busy?null:()=>setState(()=>{mode=entry.key,message=''}),child:Text(entry.value))
+    ])
+  ]);
+  Widget profileForm()=>Column(crossAxisAlignment:CrossAxisAlignment.stretch,children:[
+    const Text('Mi perfil',style:TextStyle(fontSize:22,fontWeight:FontWeight.bold)),
+    const Text('Alergias, medicamentos y antecedentes son datos autodeclarados, no diagnósticos confirmados.'),
+    for(final entry in {
+      'firstName':'Nombres','lastName':'Apellidos','birthDate':'Nacimiento (AAAA-MM-DD)',
+      'phone':'Teléfono','address':'Dirección','emergencyName':'Contacto de emergencia',
+      'emergencyPhone':'Teléfono de emergencia','allergies':'Alergias (separadas por comas)',
+      'medications':'Medicamentos habituales (separados por comas)','conditions':'Antecedentes (separados por comas)'
+    }.entries) field(profileFields[entry.key]!,entry.value),
+    action('Guardar perfil',() async {
+      final body=<String,dynamic>{'version':version};
+      for(final entry in profileFields.entries) {
+        body[entry.key]=['allergies','medications','conditions'].contains(entry.key)
+          ? entry.value.text.split(',').map((x)=>x.trim()).where((x)=>x.isNotEmpty).toList()
+          : entry.value.text.trim();
+      }
+      await api.request('PATCH','/patients/me',body:body); await load();
+      if(mounted) setState(()=>message='Perfil guardado.');
+    })
+  ]);
+  Future<void> availability() async {
+    if(serviceId==null) return;
+    final result=await api.request('GET','/availability?serviceId=$serviceId');
+    if(mounted) setState(()=>slots=result as List);
+  }
+  Widget catalog()=>Column(crossAxisAlignment:CrossAxisAlignment.stretch,children:[
+    const Text('Solicitar cita',style:TextStyle(fontSize:22,fontWeight:FontWeight.bold)),
+    if(version==0) const Text('Complete primero su perfil.'),
+    if(services.isEmpty) const Text('No hay servicios disponibles. Puede actualizar más tarde.'),
+    if(services.isNotEmpty) DropdownButton<String>(value:serviceId,isExpanded:true,
+      items:services.map((s)=>DropdownMenuItem(value:s['id'] as String,child:Text(
+        '${s['name']} · ${s['durationMinutes']} min',overflow:TextOverflow.ellipsis))).toList(),
+      onChanged:busy?null:(value)=>setState(()=>{serviceId=value,slots=[]})),
+    action('Consultar horarios',availability),
+    field(insurer,'Aseguradora para revisión manual'),
+    field(member,'Últimos 4 dígitos de afiliación'),
+    const Text('La disponibilidad no garantiza reserva. No se confirma cobertura ni copago sin revisión.'),
+    for(final slot in slots) Card(child:ListTile(
+      title:Text(localTime(slot['startAt'] as String)),
+      subtitle:Text(slot['practitionerName'] as String),
+      trailing:FilledButton(onPressed:busy||version==0?null:()=>run(() async {
+        final payload=<String,dynamic>{'slotId':slot['id'],'insurer':insurer.text.trim(),'memberLast4':member.text.trim()};
+        final fingerprint=jsonEncode(payload);
+        final key=keys.putIfAbsent(fingerprint,MilestoneRepository.uuid);
+        await api.request('POST','/appointments',body:payload,extraHeaders:{'Idempotency-Key':key});
+        await load(); await availability();
+        if(mounted) setState(()=>{tab=2,message='Solicitud guardada. Pendiente de validación; cobertura en revisión manual.'});
+      }),child:const Text('Solicitar'))))
+  ]);
+  Widget appointmentList()=>Column(crossAxisAlignment:CrossAxisAlignment.stretch,children:[
+    const Text('Mis citas',style:TextStyle(fontSize:22,fontWeight:FontWeight.bold)),
+    const Text('Estados: PendingValidation = pendiente; Confirmed = confirmada; Cancelled = cancelada.'),
+    if(appointments.isEmpty) const Text('Aún no tiene citas.'),
+    for(final a in appointments) Card(child:Padding(padding:const EdgeInsets.all(12),
+      child:Column(crossAxisAlignment:CrossAxisAlignment.start,children:[
+        Text('${a['serviceName']} · ${a['practitionerName']}'),
+        Text(localTime(a['startAt'] as String)),
+        Text('Cita: ${a['status']} · Cobertura: ${a['coverageStatus']}'),
+        if(['PendingValidation','Confirmed'].contains(a['status']) &&
+          DateTime.parse(a['startAt'] as String).isAfter(DateTime.now()))
+          Wrap(spacing:8,children:[
+            TextButton(onPressed:busy?null:()=>run(() async {
+              final confirmed=await showDialog<bool>(context:context,builder:(ctx)=>AlertDialog(
+                title:const Text('¿Cancelar esta cita?'),actions:[
+                  TextButton(onPressed:()=>Navigator.pop(ctx,false),child:const Text('Volver')),
+                  FilledButton(onPressed:()=>Navigator.pop(ctx,true),child:const Text('Cancelar cita'))]));
+              if(confirmed!=true) return;
+              await api.request('POST','/appointments/${a['id']}/cancel',body:{'version':a['version']});
+              await load();
+            }),child:const Text('Cancelar')),
+            TextButton(onPressed:busy?null:()=>run(()=>reschedule(a)),child:const Text('Reprogramar'))
+          ])
+      ])))
+  ]);
+  Future<void> reschedule(dynamic appointment) async {
+    final current=await api.request('GET','/appointments/${appointment['id']}');
+    final servicesForSpecialty=services.where((s)=>s['name']==current['serviceName']);
+    if(servicesForSpecialty.isEmpty) throw ApiFailure(409,'Servicio no disponible para reprogramar.');
+    final candidates=await api.request('GET','/availability?serviceId=${servicesForSpecialty.first['id']}') as List;
+    if(!mounted) return;
+    final chosen=await showDialog<String>(context:context,builder:(ctx)=>SimpleDialog(
+      title:const Text('Nuevo horario · volverá a revisión'),
+      children: candidates.isEmpty ? [const Padding(padding:EdgeInsets.all(16),child:Text('Sin horarios disponibles.'))] :
+        candidates.map<Widget>((s)=>SimpleDialogOption(
+          onPressed:()=>Navigator.pop(ctx,s['id'] as String),
+          child:Text('${localTime(s['startAt'] as String)} · ${s['practitionerName']}'))).toList()));
+    if(chosen==null) return;
+    await api.request('POST','/appointments/${appointment['id']}/reschedule',
+      body:{'slotId':chosen,'version':current['version']}); await load();
+  }
+}
