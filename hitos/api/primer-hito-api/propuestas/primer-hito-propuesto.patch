+using System.Security.Claims;
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Encodings.Web;
+using Microsoft.AspNetCore.Authentication;
+using Microsoft.AspNetCore.Identity;
+using Microsoft.Extensions.Options;
+using static Telemedicina.Api.Milestone.Database;
+
+namespace Telemedicina.Api.Milestone;
+
+public static class Security
+{
+    public const string Scheme = "MilestoneSession";
+    public static long Now => DateTimeOffset.UtcNow.ToUnixTimeSeconds();
+    public static string NewToken() => Convert.ToHexString(RandomNumberGenerator.GetBytes(32));
+    public static string Hash(string value) => Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(value)));
+    public static string Password(string value) => new PasswordHasher<string>().HashPassword("account", value);
+    public static bool CheckPassword(string hash, string value) =>
+        new PasswordHasher<string>().VerifyHashedPassword("account", hash, value) != PasswordVerificationResult.Failed;
+    public static string UserId(ClaimsPrincipal user) => user.FindFirstValue(ClaimTypes.NameIdentifier)!;
+    public static void Audit(Npgsql.NpgsqlConnection c, Npgsql.NpgsqlTransaction t,
+        string actor, string action, string resource, string trace) =>
+        Execute(c,t,"INSERT INTO audit(id,actor_id,action,resource_id,trace_id) VALUES(@id,@a,@b,@r,@t)",
+            ("id",Guid.NewGuid().ToString()),("a",actor),("b",action),("r",resource),("t",trace));
+
+    // RFC 6238, six digits, 30-second steps. Used only for local synthetic staff accounts.
+    public static long? TotpStep(string secret, string? code)
+    {
+        if (code is null || code.Length != 6 || code.Any(c => !char.IsAsciiDigit(c))) return null;
+        const string alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567";
+        var key = new List<byte>(); var bits=0; var buffer=0;
+        foreach(var character in secret.TrimEnd('=').ToUpperInvariant()) {
+            var index=alphabet.IndexOf(character);
+            if(index<0) return null;
+            buffer=(buffer<<5)|index; bits+=5;
+            if(bits>=8) { bits-=8; key.Add((byte)(buffer>>bits)); }
+        }
+        if(key.Count<20) return null;
+        var current=Now/30;
+        for(var step=current-1;step<=current+1;step++) {
+            var counter=BitConverter.GetBytes(System.Net.IPAddress.HostToNetworkOrder(step));
+            var digest=HMACSHA1.HashData(key.ToArray(),counter);
+            var offset=digest[^1]&15;
+            var number=((digest[offset]&127)<<24)|(digest[offset+1]<<16)|(digest[offset+2]<<8)|digest[offset+3];
+            var expected=Encoding.ASCII.GetBytes((number%1000000).ToString("D6"));
+            if(CryptographicOperations.FixedTimeEquals(expected,Encoding.ASCII.GetBytes(code))) return step;
+        }
+        return null;
+    }
+}
+
+public sealed class SessionHandler(
+    IOptionsMonitor<AuthenticationSchemeOptions> options, ILoggerFactory logger,
+    UrlEncoder encoder, Database database) : AuthenticationHandler<AuthenticationSchemeOptions>(options,logger,encoder)
+{
+    protected override Task<AuthenticateResult> HandleAuthenticateAsync()
+    {
+        var header=Request.Headers.Authorization.ToString();
+        var token=header.StartsWith("Bearer ",StringComparison.OrdinalIgnoreCase) ? header[7..] :
+            Request.Cookies["tm_access"];
+        if(string.IsNullOrEmpty(token) || token.Length>128) return Task.FromResult(AuthenticateResult.NoResult());
+        using var c=database.Open();
+        var rows=Rows(c,null,"""
+            SELECT u.id,u.email,u.role,s.id AS session_id FROM sessions s JOIN users u ON u.id=s.user_id
+            WHERE s.access_hash=@hash AND NOT s.revoked AND s.access_expires>@now
+            AND s.expires>@now AND u.active AND u.verified
+            """,("hash",Security.Hash(token)),("now",Security.Now));
+        if(rows.Count==0) return Task.FromResult(AuthenticateResult.Fail("Session expired or revoked."));
+        var row=rows[0];
+        var claims=new[] { new Claim(ClaimTypes.NameIdentifier,(string)row["id"]!),
+            new Claim(ClaimTypes.Name,(string)row["email"]!), new Claim(ClaimTypes.Role,(string)row["role"]!),
+            new Claim("session_id",(string)row["session_id"]!) };
+        return Task.FromResult(AuthenticateResult.Success(new AuthenticationTicket(
+            new ClaimsPrincipal(new ClaimsIdentity(claims,Security.Scheme)),Security.Scheme)));
+    }
+    protected override Task HandleChallengeAsync(AuthenticationProperties properties) =>
+        Reject(401,"SESSION_REQUIRED");
+    protected override Task HandleForbiddenAsync(AuthenticationProperties properties) =>
+        Reject(403,"ACCESS_DENIED");
+    private Task Reject(int status,string code)
+    {
+        Response.StatusCode=status;
+        Response.ContentType="application/problem+json";
+        return Response.WriteAsJsonAsync(new {status,title="Acceso no autorizado",code,traceId=Context.TraceIdentifier},
+            contentType:"application/problem+json");
+    }
+}
