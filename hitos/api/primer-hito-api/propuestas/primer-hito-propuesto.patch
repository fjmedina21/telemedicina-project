+"use client";
+import {useCallback,useEffect,useState} from "react";
+import {useRouter} from "next/navigation";
+import {api,ApiError,Item,localTime} from "@/lib/milestone-api";
+
+export default function AdmissionConsole({view="queue"}:{view?:"queue"|"audit"|"schedule"}) {
+  const router=useRouter();
+  const [user,setUser]=useState<{email:string;role:string}|null>(null);
+  const [items,setItems]=useState<Item[]>([]),[busy,setBusy]=useState(true),[error,setError]=useState("");
+  const [selected,setSelected]=useState<Item|null>(null),[evidence,setEvidence]=useState(""),[until,setUntil]=useState("");
+  const [services,setServices]=useState<Item[]>([]),[practitioners,setPractitioners]=useState<Item[]>([]);
+  const [service,setService]=useState(""),[practitioner,setPractitioner]=useState(""),[start,setStart]=useState("");
+  const [slots,setSlots]=useState<Item[]>([]);
+
+  const load=useCallback(async()=>{
+    const me=await api<{email:string;role:string}>("/auth/me");
+    if(me.role!=="Admission") throw new ApiError(403,"Se requiere el rol de admisión.");
+    setUser(me);
+    if(view==="audit") setItems(await api<Item[]>("/admin/audit-events"));
+    else if(view==="queue") setItems(await api<Item[]>("/admin/work-queue"));
+    else {
+      const [s,p]=await Promise.all([api<Item[]>("/services"),api<Item[]>("/practitioners")]);
+      setServices(s); setPractitioners(p);
+      setService(current=>current||String(s[0]?.id??""));
+      setPractitioner(current=>current||String(p[0]?.id??""));
+    }
+  },[view]);
+  const failure=useCallback((e:unknown)=>{
+    if(e instanceof ApiError && (e.status===401 || e.status===403)) {
+      setUser(null); setItems([]); router.replace("/login");
+    } else setError(e instanceof Error?e.message:"Error de conexión");
+  },[router]);
+  useEffect(()=>{
+    let mounted=true;
+    load().catch(e=>{if(mounted) failure(e);}).finally(()=>{if(mounted) setBusy(false);});
+    return ()=>{mounted=false;};
+  },[load,failure]);
+  async function run(action:()=>Promise<void>) {
+    if(busy) return;
+    setBusy(true); setError("");
+    try {await action();}
+    catch(e) {failure(e);}
+    finally {setBusy(false);}
+  }
+  if(!user) return <p role="status">{busy?"Verificando sesión…":error||"Se requiere iniciar sesión."}</p>;
+  return <section className="space-y-5">
+    <div className="flex flex-wrap justify-between gap-3">
+      <h1 className="text-2xl font-bold">{view==="queue"?"Admisión y cobertura":view==="audit"?"Auditoría":"Horarios"}</h1>
+      <div>{user.email} · Admisión <button className="ml-4 underline" disabled={busy}
+        onClick={()=>run(async()=>{await api("/auth/logout","POST",{});setUser(null);router.replace("/login");})}>Salir</button></div>
+    </div>
+    <p>Datos sintéticos · Estados persistentes · Zona horaria: America/Santo_Domingo</p>
+    <p role="alert" className="text-red-700">{error}</p>
+    <button disabled={busy} className="rounded border p-2" onClick={()=>run(load)}>
+      {busy?"Procesando…":"Actualizar"}</button>
+
+    {view==="queue" && <>
+      {items.length===0 && <p>No hay citas registradas.</p>}
+      <div className="overflow-x-auto"><table className="w-full text-left">
+        <thead><tr>{["Paciente","Servicio / profesional","Fecha","Cita","Cobertura","Acción"].map(t=><th key={t} className="p-2">{t}</th>)}</tr></thead>
+        <tbody>{items.map(a=><tr key={String(a.id)} className="border-t">
+          <td className="p-2">{String(a.patientEmail)}</td><td>{String(a.serviceName)} / {String(a.practitionerName)}</td>
+          <td>{localTime(a.startAt)}</td><td>{String(a.status)}</td><td>{String(a.coverageStatus)}</td>
+          <td><button className="underline" disabled={busy || !["PendingValidation","Confirmed"].includes(String(a.status))}
+            onClick={()=>{setSelected(a);setEvidence("");setUntil("");}}>Revisar</button></td>
+        </tr>)}</tbody>
+      </table></div>
+      {selected && <form className="space-y-3 rounded-xl border bg-white p-5" onSubmit={e=>e.preventDefault()}>
+        <h2 className="font-bold">Revisión manual · {String(selected.patientEmail)}</h2>
+        <p>Aseguradora: {String(selected.insurer)} · Afiliación: ****{String(selected.memberLast4)}</p>
+        <label className="block">Referencia de evidencia (sin texto clínico)
+          <input className="block w-full rounded border p-2" required maxLength={250} value={evidence}
+            onChange={e=>setEvidence(e.target.value)}/></label>
+        <label className="block">Vigencia hasta (hora de Santo Domingo)
+          <input className="block rounded border p-2" type="datetime-local" value={until}
+            onChange={e=>setUntil(e.target.value)}/></label>
+        <p>Una aprobación requiere evidencia y vigencia que cubra la cita. Una denegación no autoriza atención particular.</p>
+        <div className="flex flex-wrap gap-3">{[
+          ["ManualReview","Mantener en revisión"],["Approved","Aprobar cobertura y confirmar"],["Denied","Denegar cobertura"]
+        ].map(([status,label])=><button key={status} disabled={busy||!evidence.trim()||(status==="Approved"&&!until)}
+          className="rounded bg-teal-700 p-2 text-white disabled:opacity-50"
+          onClick={()=>run(async()=>{
+            await api("/admin/appointments/"+selected.id+"/validation","PATCH",{
+              status,evidence,version:selected.version,validUntil:until?new Date(until+"-04:00").toISOString():null
+            });
+            setSelected(null); await load();
+          })}>{label}</button>)}</div>
+        <button onClick={()=>setSelected(null)} className="underline">Cerrar</button>
+      </form>}
+    </>}
+
+    {view==="audit" && <>
+      <p>Primeros 100 eventos. No se muestran contraseñas, tokens ni contenido clínico.</p>
+      <ol className="space-y-2">{items.map(a=><li key={String(a.id)} className="rounded border bg-white p-3">
+        {localTime(a.occurredAt)} · {String(a.action)} · Actor {String(a.actorId)} · Recurso {String(a.resourceId)}
+      </li>)}</ol>
+      {items.length>0 && <button disabled={busy} className="underline" onClick={()=>run(async()=>{
+        const next=await api<Item[]>("/admin/audit-events?after="+items[items.length-1].sequence);
+        setItems(next);
+      })}>Siguiente página</button>}
+    </>}
+
+    {view==="schedule" && <div className="space-y-3 rounded-xl border bg-white p-5">
+      <label className="block">Servicio<select className="ml-2 rounded border p-2" value={service}
+        onChange={e=>{setService(e.target.value);setSlots([]);}}>
+        {services.map(s=><option key={String(s.id)} value={String(s.id)}>{String(s.name)}</option>)}</select></label>
+      <label className="block">Profesional<select className="ml-2 rounded border p-2" value={practitioner}
+        onChange={e=>{setPractitioner(e.target.value);setSlots([]);}}>
+        {practitioners.map(p=><option key={String(p.id)} value={String(p.id)}>{String(p.name)}</option>)}</select></label>
+      <label className="block">Inicio (hora de Santo Domingo)<input className="ml-2 rounded border p-2"
+        type="datetime-local" value={start} onChange={e=>setStart(e.target.value)}/></label>
+      <button disabled={busy||!start||!service||!practitioner} className="rounded border p-2"
+        onClick={()=>run(async()=>{
+          await api("/admin/slots","POST",{serviceId:service,practitionerId:practitioner,
+            startAt:new Date(start+"-04:00").toISOString()}); setStart("");setError("Horario creado.");
+        })}>Crear horario</button>
+      <button disabled={busy||!service||!practitioner} className="ml-2 rounded border p-2"
+        onClick={()=>run(async()=>setSlots(await api<Item[]>(
+          "/availability?serviceId="+service+"&practitionerId="+practitioner)))}>Consultar horarios libres</button>
+      {slots.map(s=><div key={String(s.id)} className="flex justify-between rounded border p-2">
+        {localTime(s.startAt)}
+        <button disabled={busy} className="underline" onClick={()=>run(async()=>{
+          await api("/admin/slots/"+s.id+"/block","PATCH",{blocked:true});
+          setSlots(current=>current.filter(slot=>slot.id!==s.id));
+        })}>Bloquear</button>
+      </div>)}
+    </div>}
+  </section>;
+}
diff --git a/portalweb/src/src/lib/milestone-api.ts b/portalweb/src/src/lib/milestone-api.ts
new file mode 100644
