new file mode 100644
--- /dev/null
+++ b/api/src/Telemedicina.Api/Milestone/Bootstrap.cs
@@ -0,0 +1,87 @@
+using System.Threading.RateLimiting;
+using Microsoft.AspNetCore.Authentication;
+using static Telemedicina.Api.Milestone.Database;
+using static Telemedicina.Api.Milestone.Security;
+
+namespace Telemedicina.Api.Milestone;
+
+public static class Bootstrap
+{
+    public static void AddMilestone(this WebApplicationBuilder builder)
+    {
+        builder.Services.AddSingleton<Database>();
+        builder.Services.AddAuthentication(Security.Scheme)
+            .AddScheme<AuthenticationSchemeOptions,SessionHandler>(Security.Scheme,_=>{});
+        builder.Services.AddAuthorization();
+        builder.Services.AddRateLimiter(options => {
+            options.RejectionStatusCode=429;
+            options.AddPolicy("auth",context=>RateLimitPartition.GetFixedWindowLimiter(
+                context.Connection.RemoteIpAddress?.ToString() ?? "unknown",
+                _=>new FixedWindowRateLimiterOptions {PermitLimit=30,Window=TimeSpan.FromMinutes(1),QueueLimit=0}));
+        });
+    }
+    public static void UseMilestone(this WebApplication app)
+    {
+        app.Use(async(context,next)=> {
+            if(context.Request.Path.StartsWithSegments("/api/v1") &&
+                !context.Request.Path.Equals("/api/v1/health",StringComparison.OrdinalIgnoreCase))
+            {
+                if(!app.Environment.IsDevelopment() || !app.Configuration.GetValue<bool>("Milestone:Enabled")) {
+                    context.Response.StatusCode=404; return;
+                }
+                context.Response.Headers.CacheControl="no-store";
+                var origin=context.Request.Headers.Origin.ToString();
+                var allowed=app.Configuration["Milestone:PortalOrigin"] ?? "http://localhost:3000";
+                if(!string.IsNullOrEmpty(origin) && origin!=allowed) {
+                    context.Response.StatusCode=403; return;
+                }
+                if(!HttpMethods.IsGet(context.Request.Method) && !HttpMethods.IsOptions(context.Request.Method)
+                    && context.Request.Headers["X-Telemedicina-Client"]!="milestone") {
+                    context.Response.StatusCode=403; return;
+                }
+            }
+            await next(context);
+        });
+        app.UseRateLimiter();
+        app.UseAuthentication();
+    }
+
+    public static void SeedSynthetic(Database database,IConfiguration config)
+    {
+        using var c=database.Open(); using var t=c.BeginTransaction();
+        Execute(c,t,"SELECT pg_advisory_xact_lock(19041302)");
+        const string service="10000000-0000-4000-8000-000000000001";
+        const string practitioner="20000000-0000-4000-8000-000000000001";
+        Execute(c,t,"""
+            INSERT INTO services(id,specialty,name,duration)
+            VALUES(@id,'Demostración','Servicio sintético: no habilitado para atención clínica',30)
+            ON CONFLICT DO NOTHING
+            """,("id",service));
+        Execute(c,t,"INSERT INTO practitioners(id,name) VALUES(@id,'Profesional de demostración') ON CONFLICT DO NOTHING",
+            ("id",practitioner));
+        for(var day=1;day<=14;day++)
+        for(var hour=9;hour<=16;hour++) {
+            var date=DateTime.UtcNow.Date.AddDays(day);
+            var start=new DateTimeOffset(date.Year,date.Month,date.Day,hour,0,0,TimeSpan.FromHours(-4)).UtcDateTime;
+            var id=new Guid(System.Security.Cryptography.MD5.HashData(
+                System.Text.Encoding.UTF8.GetBytes(practitioner+start.ToString("O")))).ToString();
+            Execute(c,t,"""
+                INSERT INTO slots(id,service_id,practitioner_id,start_utc,end_utc)
+                VALUES(@id,@s,@p,@start,@end) ON CONFLICT DO NOTHING
+                """,("id",id),("s",service),("p",practitioner),("start",start),("end",start.AddMinutes(30)));
+        }
+        var email=config["Milestone:AdmissionEmail"];
+        var password=config["Milestone:AdmissionPassword"];
+        var totp=config["Milestone:AdmissionTotpSecret"];
+        if(string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password) || password.Length<12 ||
+            string.IsNullOrWhiteSpace(totp) || totp.Length<32 ||
+            totp.Any(ch=>!"ABCDEFGHIJKLMNOPQRSTUVWXYZ234567".Contains(char.ToUpperInvariant(ch))))
+            throw new InvalidOperationException("Configure synthetic admission email, password (12+ chars) and Base32 TOTP secret (32+ chars).");
+        Execute(c,t,"""
+            INSERT INTO users(id,email,password_hash,role,verified,totp_secret)
+            VALUES(@id,@email,@hash,'Admission',true,@totp) ON CONFLICT DO NOTHING
+            """,("id",Guid.NewGuid().ToString()),("email",email.Trim().ToLowerInvariant()),
+            ("hash",Password(password)),("totp",totp));
+        Audit(c,t,"seed","synthetic.seed_applied",service,"seed"); t.Commit();
+    }
+}
diff --git a/api/src/Telemedicina.Api/Milestone/CareController.cs b/api/src/Telemedicina.Api/Milestone/CareController.cs
new file mode 100644
--- /dev/null
+++ b/api/src/Telemedicina.Api/Milestone/CareController.cs
@@ -0,0 +1,287 @@
+using System.Text.Json;
+using Microsoft.AspNetCore.Authorization;
+using Microsoft.AspNetCore.Mvc;
+using static Telemedicina.Api.Milestone.Database;
+using static Telemedicina.Api.Milestone.Security;
+
+namespace Telemedicina.Api.Milestone;
+
+[ApiController,Authorize,Route("api/v1")]
+public sealed class CareController(Database database) : ControllerBase
+{
+    private static readonly JsonSerializerOptions Json=new(JsonSerializerDefaults.Web);
+    private IActionResult Data(object? data,int status=200) => StatusCode(status,new {success=true,status,detail="OK",data});
+    private IActionResult Fail(int status,string code,string message) => StatusCode(status,new {
+        status,title=message,code,traceId=HttpContext.TraceIdentifier});
+    private Npgsql.NpgsqlTransaction Begin(Npgsql.NpgsqlConnection c)
+    {
+        var t=c.BeginTransaction();
+        Execute(c,t,"SELECT set_config('telemedicina.actor',@actor,true)",("actor",UserId(User)));
+        return t;
+    }
+    private void Log(Npgsql.NpgsqlConnection c,Npgsql.NpgsqlTransaction t,string action,string id) =>
+        Audit(c,t,UserId(User),action,id,HttpContext.TraceIdentifier);
+
+    [Authorize(Roles="Patient"),HttpGet("patients/me")]
+    public IActionResult Profile()
+    {
+        using var c=database.Open();
+        var rows=Rows(c,null,"SELECT body,version,updated_at FROM profiles WHERE user_id=@u",("u",UserId(User)));
+        return Data(rows.Count==0 ? null : new {profile=JsonSerializer.Deserialize<JsonElement>((string)rows[0]["body"]!),
+            version=rows[0]["version"],updatedAt=rows[0]["updated_at"],source="SelfDeclared"});
+    }
+    [Authorize(Roles="Patient"),HttpPatch("patients/me")]
+    public IActionResult SaveProfile(ProfileRequest request)
+    {
+        if(request.BirthDate>=DateOnly.FromDateTime(DateTime.UtcNow) || request.BirthDate.Year<1900 ||
+            new[]{request.FirstName,request.LastName,request.Address,request.EmergencyName}.Any(string.IsNullOrWhiteSpace) ||
+            request.Allergies is null || request.Medications is null || request.Conditions is null ||
+            request.Allergies.Concat(request.Medications).Concat(request.Conditions).Any(x=>string.IsNullOrWhiteSpace(x)||x.Length>200))
+            return Fail(400,"INVALID_PROFILE","Revise los datos del perfil.");
+        using var c=database.Open(); using var t=Begin(c);
+        Execute(c,t,"SELECT pg_advisory_xact_lock(hashtextextended(@key,0))",("key","profile:"+UserId(User)));
+        var version=Scalar(c,t,"SELECT version FROM profiles WHERE user_id=@u FOR UPDATE",("u",UserId(User)));
+        if((version is null && request.Version!=0) || (version is not null && (int)version!=request.Version))
+            return Fail(409,"VERSION_CONFLICT","El perfil cambió. Actualice antes de guardar.");
+        Execute(c,t,"""
+            INSERT INTO profiles(user_id,body,version) VALUES(@u,@body,1)
+            ON CONFLICT(user_id) DO UPDATE SET body=excluded.body,version=profiles.version+1,updated_at=now()
+            """,("u",UserId(User)),("body",JsonSerializer.Serialize(request,Json)));
+        Log(c,t,"profile.updated",UserId(User)); t.Commit();
+        return Data(new {version=request.Version+1});
+    }
+
+    [HttpGet("specialties")]
+    public IActionResult Specialties()
+    {
+        using var c=database.Open();
+        return Data(Rows(c,null,"SELECT DISTINCT specialty AS name FROM services WHERE active ORDER BY specialty"));
+    }
+    [HttpGet("services")]
+    public IActionResult Services([FromQuery]string? specialty=null)
+    {
+        using var c=database.Open();
+        return Data(Rows(c,null,"""
+            SELECT id,name,specialty,duration AS "durationMinutes" FROM services
+            WHERE active AND (@s='' OR specialty=@s) ORDER BY name
+            """,("s",specialty ?? "")));
+    }
+    [HttpGet("practitioners")]
+    public IActionResult Practitioners()
+    {
+        using var c=database.Open();
+        return Data(Rows(c,null,"SELECT id,name FROM practitioners WHERE active ORDER BY name"));
+    }
+    [HttpGet("availability")]
+    public IActionResult Availability([FromQuery]Guid serviceId,[FromQuery]DateTimeOffset? from=null,
+        [FromQuery]DateTimeOffset? to=null,[FromQuery]string? practitionerId=null)
+    {
+        var start=(from ?? DateTimeOffset.UtcNow).UtcDateTime;
+        var end=(to ?? DateTimeOffset.UtcNow.AddDays(14)).UtcDateTime;
+        if(end<=start || end-start>TimeSpan.FromDays(31)) return Fail(400,"INVALID_RANGE","Rango máximo: 31 días.");
+        using var c=database.Open();
+        return Data(Rows(c,null,"""
+            SELECT s.id,s.service_id AS "serviceId",p.id AS "practitionerId",p.name AS "practitionerName",
+                s.start_utc AS "startAt",s.end_utc AS "endAt",v.name AS "serviceName",v.specialty
+            FROM slots s JOIN services v ON v.id=s.service_id JOIN practitioners p ON p.id=s.practitioner_id
+            WHERE s.service_id=@sid AND v.active AND p.active AND NOT s.blocked
+            AND s.start_utc>now() AND s.start_utc>=@from AND s.end_utc<=@to
+            AND (@pid='' OR p.id=@pid)
+            AND NOT EXISTS(SELECT 1 FROM appointments a WHERE a.slot_id=s.id AND a.status IN ('PendingValidation','Confirmed'))
+            ORDER BY s.start_utc,p.name LIMIT 300
+            """,("sid",serviceId.ToString()),("from",start),("to",end),("pid",practitionerId ?? "")));
+    }
+    private const string AppointmentSelect="""
+        SELECT a.id,a.user_id AS "patientId",u.email AS "patientEmail",a.slot_id AS "slotId",
+            p.name AS "practitionerName",v.name AS "serviceName",v.specialty,
+            a.start_utc AS "startAt",a.end_utc AS "endAt",a.status,
+            CASE WHEN a.coverage='Approved' AND a.coverage_valid_until<now() THEN 'Expired' ELSE a.coverage END AS "coverageStatus",
+            a.insurer,a.member_last4 AS "memberLast4",a.version,a.evidence,
+            a.reviewed_by AS "reviewedBy",a.reviewed_at AS "reviewedAt",a.coverage_valid_until AS "validUntil"
+        FROM appointments a JOIN slots s ON s.id=a.slot_id JOIN services v ON v.id=s.service_id
+        JOIN practitioners p ON p.id=a.practitioner_id JOIN users u ON u.id=a.user_id
+        """;
+    [Authorize(Roles="Patient"),HttpGet("appointments/me")]
+    public IActionResult Mine()
+    {
+        using var c=database.Open();
+        return Data(Rows(c,null,AppointmentSelect+" WHERE a.user_id=@u ORDER BY a.start_utc DESC LIMIT 100",("u",UserId(User))));
+    }
+    [HttpGet("appointments/{id:guid}")]
+    public IActionResult Detail(Guid id)
+    {
+        using var c=database.Open(); using var t=Begin(c);
+        var rows=Rows(c,t,AppointmentSelect+" WHERE a.id=@id AND (@staff OR a.user_id=@u)",
+            ("id",id.ToString()),("staff",User.IsInRole("Admission")),("u",UserId(User)));
+        if(rows.Count==0) return NotFound();
+        Log(c,t,"appointment.read",id.ToString()); t.Commit(); return Data(rows[0]);
+    }
+    [Authorize(Roles="Patient"),HttpPost("appointments")]
+    public IActionResult Book(BookRequest request)
+    {
+        var key=Request.Headers["Idempotency-Key"].ToString();
+        if(!Guid.TryParse(key,out _)) return Fail(400,"IDEMPOTENCY_REQUIRED","Envíe Idempotency-Key como UUID.");
+        if(string.IsNullOrWhiteSpace(request.Insurer)) return Fail(400,"INSURER_REQUIRED","Indique aseguradora para revisión manual.");
+        var payload=Hash(JsonSerializer.Serialize(request,Json));
+        using var c=database.Open(); using var t=Begin(c);
+        // Serialize retries for this user/key before checking the stored result.
+        Execute(c,t,"SELECT pg_advisory_xact_lock(hashtextextended(@key,0))",("key",UserId(User)+":"+key));
+        var old=Rows(c,t,"SELECT request_hash,response FROM idempotency WHERE user_id=@u AND key=@k",
+            ("u",UserId(User)),("k",key));
+        if(old.Count>0) return (string)old[0]["request_hash"]! == payload
+            ? Data(JsonSerializer.Deserialize<JsonElement>((string)old[0]["response"]!))
+            : Fail(409,"IDEMPOTENCY_MISMATCH","La clave ya se usó con otra solicitud.");
+        if(Scalar(c,t,"SELECT user_id FROM profiles WHERE user_id=@u",("u",UserId(User))) is null)
+            return Fail(400,"PROFILE_REQUIRED","Complete el perfil antes de solicitar.");
+        var slots=Rows(c,t,"""
+            SELECT s.* FROM slots s JOIN services v ON v.id=s.service_id
+            JOIN practitioners p ON p.id=s.practitioner_id
+            WHERE s.id=@id AND NOT s.blocked AND s.start_utc>now() AND p.active AND v.active FOR UPDATE OF s
+            """,("id",request.SlotId.ToString()));
+        if(slots.Count==0) return Fail(409,"SLOT_UNAVAILABLE","Horario no disponible.");
+        var slot=slots[0]; var id=Guid.NewGuid().ToString();
+        try {
+            Execute(c,t,"""
+                INSERT INTO appointments(id,user_id,slot_id,practitioner_id,start_utc,end_utc,status,coverage,insurer,member_last4)
+                VALUES(@id,@u,@s,@p,@start,@end,'PendingValidation','ManualReview',@insurer,@member)
+                """,("id",id),("u",UserId(User)),("s",request.SlotId.ToString()),("p",slot["practitioner_id"]),
+                ("start",slot["start_utc"]),("end",slot["end_utc"]),("insurer",request.Insurer.Trim()),("member",request.MemberLast4));
+        } catch(Npgsql.PostgresException e) when(e.SqlState is "23505" or "23P01") {
+            return Fail(409,"SLOT_UNAVAILABLE","Otro paciente solicitó ese horario. Seleccione otro.");
+        }
+        var result=new {id,status="PendingValidation",coverageStatus="ManualReview",version=1};
+        Execute(c,t,"INSERT INTO idempotency(user_id,key,request_hash,response) VALUES(@u,@k,@h,@r)",
+            ("u",UserId(User)),("k",key),("h",payload),("r",JsonSerializer.Serialize(result,Json)));
+        Log(c,t,"appointment.requested",id); t.Commit(); return Data(result,201);
+    }
+    [HttpGet("appointments/{id:guid}/history")]
+    public IActionResult History(Guid id)
+    {
+        using var c=database.Open(); using var t=Begin(c);
+        if(Scalar(c,t,"SELECT id FROM appointments WHERE id=@id AND (@staff OR user_id=@u)",
+            ("id",id.ToString()),("staff",User.IsInRole("Admission")),("u",UserId(User))) is null) return NotFound();
+        var rows=Rows(c,t,"""
+            SELECT sequence,old_slot_id AS "oldSlotId",new_slot_id AS "newSlotId",old_status AS "oldStatus",
+            new_status AS "newStatus",old_coverage AS "oldCoverage",new_coverage AS "newCoverage",
+            version,actor_id AS "actorId",occurred_at AS "occurredAt"
+            FROM appointment_history WHERE appointment_id=@id ORDER BY sequence
+            """,("id",id.ToString()));
+        Log(c,t,"appointment.history_read",id.ToString()); t.Commit(); return Data(rows);
+    }
+    [Authorize(Roles="Patient"),HttpPost("appointments/{id:guid}/cancel")]
+    public IActionResult Cancel(Guid id,VersionRequest request)
+    {
+        using var c=database.Open(); using var t=Begin(c);
+        var row=Rows(c,t,"SELECT * FROM appointments WHERE id=@id AND user_id=@u FOR UPDATE",
+            ("id",id.ToString()),("u",UserId(User))).FirstOrDefault();
+        if(row is null) return NotFound();
+        if((int)row["version"]! != request.Version || (string)row["status"]! is not ("PendingValidation" or "Confirmed")
+            || (DateTime)row["start_utc"]!<=DateTime.UtcNow)
+            return Fail(409,"INVALID_TRANSITION","La cita cambió o ya no permite cancelación.");
+        Execute(c,t,"UPDATE appointments SET status='Cancelled',version=version+1 WHERE id=@id",("id",id.ToString()));
+        Log(c,t,"appointment.cancelled",id.ToString()); t.Commit(); return Data(new {cancelled=true});
+    }
+    [Authorize(Roles="Patient"),HttpPost("appointments/{id:guid}/reschedule")]
+    public IActionResult Reschedule(Guid id,RescheduleRequest request)
+    {
+        using var c=database.Open(); using var t=Begin(c);
+        var a=Rows(c,t,"SELECT * FROM appointments WHERE id=@id AND user_id=@u FOR UPDATE",
+            ("id",id.ToString()),("u",UserId(User))).FirstOrDefault();
+        if(a is null) return NotFound();
+        if((int)a["version"]! != request.Version || (string)a["status"]! is not ("PendingValidation" or "Confirmed") ||
+            (DateTime)a["start_utc"]!<=DateTime.UtcNow)
+            return Fail(409,"INVALID_TRANSITION","La cita cambió o ya no permite reprogramación.");
+        var s=Rows(c,t,"""
+            SELECT s.* FROM slots s JOIN services v ON v.id=s.service_id JOIN practitioners p ON p.id=s.practitioner_id
+            WHERE s.id=@id AND NOT s.blocked AND s.start_utc>now() AND v.active AND p.active FOR UPDATE OF s
+            """,("id",request.SlotId.ToString())).FirstOrDefault();
+        if(s is null) return Fail(409,"SLOT_UNAVAILABLE","Horario no disponible.");
+        try {
+            Execute(c,t,"""
+                UPDATE appointments SET slot_id=@slot,practitioner_id=@p,start_utc=@start,end_utc=@end,
+                status='PendingValidation',coverage='ManualReview',evidence=NULL,coverage_valid_until=NULL,
+                reviewed_by=NULL,reviewed_at=NULL,version=version+1 WHERE id=@id
+                """,("slot",request.SlotId.ToString()),("p",s["practitioner_id"]),("start",s["start_utc"]),
+                ("end",s["end_utc"]),("id",id.ToString()));
+        } catch(Npgsql.PostgresException e) when(e.SqlState is "23505" or "23P01") {
+            return Fail(409,"SLOT_UNAVAILABLE","El horario ya fue solicitado.");
+        }
+        Log(c,t,"appointment.rescheduled",id.ToString()); t.Commit(); return Data(new {rescheduled=true});
+    }
+    [Authorize(Roles="Admission"),HttpGet("admin/work-queue")]
+    public IActionResult Queue()
+    {
+        using var c=database.Open();
+        return Data(Rows(c,null,AppointmentSelect+" ORDER BY a.start_utc DESC LIMIT 200"));
+    }
+    [Authorize(Roles="Admission"),HttpPatch("admin/appointments/{id:guid}/validation")]
+    public IActionResult Review(Guid id,CoverageRequest request)
+    {
+        using var c=database.Open(); using var t=Begin(c);
+        var a=Rows(c,t,"SELECT * FROM appointments WHERE id=@id FOR UPDATE",("id",id.ToString())).FirstOrDefault();
+        if(a is null) return NotFound();
+        if((int)a["version"]! != request.Version || (string)a["status"]! is not ("PendingValidation" or "Confirmed")
+            || (DateTime)a["start_utc"]!<=DateTime.UtcNow)
+            return Fail(409,"INVALID_TRANSITION","La cita cambió o ya no permite revisión.");
+        if(string.IsNullOrWhiteSpace(request.Evidence) || (request.Status=="Approved" &&
+            (request.ValidUntil is null || request.ValidUntil.Value.UtcDateTime<(DateTime)a["end_utc"]!)))
+            return Fail(400,"EVIDENCE_REQUIRED","Registre evidencia y una vigencia que cubra la cita.");
+        var next=request.Status=="Approved" ? "Confirmed" : "PendingValidation";
+        Execute(c,t,"""
+            UPDATE appointments SET coverage=@coverage,status=@status,evidence=@e,coverage_valid_until=@until,
+            reviewed_by=@actor,reviewed_at=now(),version=version+1 WHERE id=@id
+            """,("coverage",request.Status),("status",next),("e",request.Evidence.Trim()),
+            ("until",request.ValidUntil?.UtcDateTime),("actor",UserId(User)),("id",id.ToString()));
+        Log(c,t,"coverage."+request.Status.ToLowerInvariant(),id.ToString()); t.Commit();
+        return Data(new {status=next,coverageStatus=request.Status,version=request.Version+1});
+    }
+    [Authorize(Roles="Admission"),HttpGet("admin/audit-events")]
+    public IActionResult AuditEvents([FromQuery]int after=0)
+    {
+        using var c=database.Open();
+        return Data(Rows(c,null,"""
+            SELECT sequence,id,actor_id AS "actorId",action,resource_id AS "resourceId",
+            occurred_at AS "occurredAt",trace_id AS "traceId" FROM audit
+            WHERE sequence>@after ORDER BY sequence LIMIT 100
+            """,("after",after)));
+    }
+    [Authorize(Roles="Admission"),HttpPost("admin/slots")]
+    public IActionResult AddSlot(SlotRequest request)
+    {
+        if(request.StartAt<=DateTimeOffset.UtcNow) return Fail(400,"INVALID_DATE","Seleccione una fecha futura.");
+        using var c=database.Open(); using var t=Begin(c);
+        var duration=Scalar(c,t,"SELECT duration FROM services WHERE id=@id AND active",("id",request.ServiceId.ToString()));
+        if(duration is null || Scalar(c,t,"SELECT id FROM practitioners WHERE id=@id AND active",
+            ("id",request.PractitionerId.ToString())) is null) return NotFound();
+        var id=Guid.NewGuid().ToString();
+        try {
+            Execute(c,t,"INSERT INTO slots(id,service_id,practitioner_id,start_utc,end_utc) VALUES(@id,@s,@p,@start,@end)",
+                ("id",id),("s",request.ServiceId.ToString()),("p",request.PractitionerId.ToString()),
+                ("start",request.StartAt.UtcDateTime),("end",request.StartAt.AddMinutes((int)duration).UtcDateTime));
+        } catch(Npgsql.PostgresException e) when(e.SqlState=="23P01") {
+            return Fail(409,"SCHEDULE_OVERLAP","El profesional ya tiene un horario que solapa.");
+        }
+        Log(c,t,"schedule.slot_created",id); t.Commit(); return Data(new {id},201);
+    }
+    [Authorize(Roles="Admission"),HttpPatch("admin/slots/{id:guid}/block")]
+    public IActionResult Block(Guid id,BlockRequest request)
+    {
+        using var c=database.Open(); using var t=Begin(c);
+        if(Scalar(c,t,"SELECT id FROM slots WHERE id=@id FOR UPDATE",("id",id.ToString())) is null) return NotFound();
+        if(request.Blocked && Scalar(c,t,"SELECT id FROM appointments WHERE slot_id=@id AND status IN ('PendingValidation','Confirmed')",
+            ("id",id.ToString())) is not null) return Fail(409,"SLOT_RESERVED","Gestione primero las citas existentes.");
+        Execute(c,t,"UPDATE slots SET blocked=@b WHERE id=@id",("b",request.Blocked),("id",id.ToString()));
+        Log(c,t,"schedule.block_changed",id.ToString()); t.Commit(); return Data(new {blocked=request.Blocked});
+    }
+    [Authorize(Roles="Admission"),HttpPatch("admin/users/{id:guid}/active")]
+    public IActionResult Active(Guid id,ActiveRequest request)
+    {
+        if(id.ToString()==UserId(User)) return Fail(400,"SELF_SUSPENSION","No puede suspender su propia cuenta.");
+        using var c=database.Open(); using var t=Begin(c);
+        var count=Execute(c,t,"UPDATE users SET active=@active WHERE id=@id AND role='Patient'",
+            ("active",request.Active),("id",id.ToString()));
+        if(count==0) return NotFound();
+        if(!request.Active) Execute(c,t,"UPDATE sessions SET revoked=true WHERE user_id=@id",("id",id.ToString()));
+        Log(c,t,"account.active_changed",id.ToString()); t.Commit(); return Data(new {active=request.Active});
+    }
+}
