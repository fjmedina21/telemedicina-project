diff --git a/api/src/Telemedicina.Api/Milestone/CatalogController.cs b/api/src/Telemedicina.Api/Milestone/CatalogController.cs
new file mode 100644
--- /dev/null
+++ b/api/src/Telemedicina.Api/Milestone/CatalogController.cs
@@ -0,0 +1,113 @@
+using System.ComponentModel.DataAnnotations;
+using Microsoft.AspNetCore.Authorization;
+using Microsoft.AspNetCore.Mvc;
+using Npgsql;
+using static Telemedicina.Api.Milestone.Database;
+using static Telemedicina.Api.Milestone.Security;
+
+namespace Telemedicina.Api.Milestone;
+
+public sealed record CatalogServiceRequest(
+    [Required,MaxLength(120)] string Name,[Required,MaxLength(100)] string Specialty,
+    [Range(5,240)] int DurationMinutes,bool Active,bool IsSynthetic,
+    [MaxLength(250)] string? ApprovalReference,[Range(0,int.MaxValue)] int Version=0);
+public sealed record CatalogPractitionerRequest(
+    [Required,MaxLength(120)] string Name,[MaxLength(100)] string? LicenseRef,
+    bool Active,[Required,MaxLength(100)] string[] ServiceIds,[Range(0,int.MaxValue)] int Version=0);
+
+[ApiController,Authorize(Roles="Admission"),Route("api/v1/admin/catalog")]
+public sealed class CatalogController(Database database):ControllerBase
+{
+    private IActionResult Data(object data,int status=200)=>StatusCode(status,new {success=true,status,detail="OK",data});
+    private IActionResult Fail(int status,string code,string title)=>StatusCode(status,new {status,code,title,traceId=HttpContext.TraceIdentifier});
+
+    [HttpGet("services")]
+    public IActionResult Services()
+    {
+        using var c=database.Open();
+        return Data(Rows(c,null,"""
+            SELECT id,name,specialty,duration AS "durationMinutes",active,is_synthetic AS "isSynthetic",
+            approval_reference AS "approvalReference",version FROM services ORDER BY name
+            """));
+    }
+    [HttpPost("services")]
+    public IActionResult CreateService(CatalogServiceRequest request)=>SaveService(null,request);
+    [HttpPatch("services/{id:guid}")]
+    public IActionResult UpdateService(Guid id,CatalogServiceRequest request)=>SaveService(id.ToString(),request);
+    private IActionResult SaveService(string? id,CatalogServiceRequest request)
+    {
+        if(string.IsNullOrWhiteSpace(request.Name)||string.IsNullOrWhiteSpace(request.Specialty)||
+            (request.Active&&!request.IsSynthetic&&string.IsNullOrWhiteSpace(request.ApprovalReference)))
+            return Fail(400,"CATALOG_VALIDATION","Complete nombre, especialidad y referencia de habilitación si el servicio no es sintético.");
+        using var c=database.Open(); using var t=c.BeginTransaction();
+        var created=id is null; id ??= Guid.NewGuid().ToString();var version=1;
+        if(!created)
+        {
+            var row=Rows(c,t,"SELECT version,duration FROM services WHERE id=@id FOR UPDATE",("id",id)).FirstOrDefault();
+            if(row is null) return NotFound();
+            if((int)row["version"]! != request.Version) return Fail(409,"VERSION_CONFLICT","El servicio cambió. Actualice la lista.");
+            if((int)row["duration"]! != request.DurationMinutes &&
+                Convert.ToInt64(Scalar(c,t,"SELECT count(*) FROM slots WHERE service_id=@id AND start_utc>now()",("id",id)))>0)
+                return Fail(409,"EXISTING_SCHEDULE","El servicio tiene horarios futuros con otra duración; cree una versión nueva del servicio.");
+            version=request.Version+1;
+            Execute(c,t,"""
+                UPDATE services SET name=@name,specialty=@specialty,duration=@duration,active=@active,
+                is_synthetic=@synthetic,approval_reference=@reference,version=@version WHERE id=@id
+                """,("name",request.Name.Trim()),("specialty",request.Specialty.Trim()),("duration",request.DurationMinutes),
+                ("active",request.Active),("synthetic",request.IsSynthetic),("reference",request.ApprovalReference?.Trim()),
+                ("version",version),("id",id));
+        }
+        else Execute(c,t,"""
+            INSERT INTO services(id,name,specialty,duration,active,is_synthetic,approval_reference)
+            VALUES(@id,@name,@specialty,@duration,@active,@synthetic,@reference)
+            """,("id",id),("name",request.Name.Trim()),("specialty",request.Specialty.Trim()),("duration",request.DurationMinutes),
+            ("active",request.Active),("synthetic",request.IsSynthetic),("reference",request.ApprovalReference?.Trim()));
+        Audit(c,t,UserId(User),created?"catalog.service_created":"catalog.service_updated",id,HttpContext.TraceIdentifier);
+        t.Commit();return Data(new {id,version},created?201:200);
+    }
+
+    [HttpGet("practitioners")]
+    public IActionResult Practitioners()
+    {
+        using var c=database.Open();
+        return Data(Rows(c,null,"""
+            SELECT p.id,p.name,p.active,p.version,p.license_ref AS "licenseRef",
+                ARRAY(SELECT service_id FROM practitioner_services ps
+                    WHERE ps.practitioner_id=p.id AND ps.active ORDER BY service_id) AS "serviceIds"
+            FROM practitioners p ORDER BY p.name
+            """));
+    }
+    [HttpPost("practitioners")]
+    public IActionResult CreatePractitioner(CatalogPractitionerRequest request)=>SavePractitioner(null,request);
+    [HttpPatch("practitioners/{id:guid}")]
+    public IActionResult UpdatePractitioner(Guid id,CatalogPractitionerRequest request)=>SavePractitioner(id.ToString(),request);
+    private IActionResult SavePractitioner(string? id,CatalogPractitionerRequest request)
+    {
+        if(string.IsNullOrWhiteSpace(request.Name)||request.ServiceIds is null||request.ServiceIds.Any(x=>!Guid.TryParse(x,out _)))
+            return Fail(400,"CATALOG_VALIDATION","Revise nombre y servicios asignados.");
+        var ids=request.ServiceIds.Select(x=>Guid.Parse(x).ToString()).Distinct().ToArray();
+        using var c=database.Open();using var t=c.BeginTransaction();
+        if(Convert.ToInt64(Scalar(c,t,"SELECT count(*) FROM services WHERE id=ANY(@ids)",("ids",ids)))!=ids.Length)
+            return Fail(400,"UNKNOWN_SERVICE","Uno de los servicios no existe.");
+        var created=id is null;id ??= Guid.NewGuid().ToString();var version=1;
+        if(!created)
+        {
+            var old=Scalar(c,t,"SELECT version FROM practitioners WHERE id=@id FOR UPDATE",("id",id));
+            if(old is null) return NotFound();
+            if((int)old!=request.Version) return Fail(409,"VERSION_CONFLICT","El profesional cambió. Actualice la lista.");
+            version=request.Version+1;
+            Execute(c,t,"UPDATE practitioners SET name=@name,license_ref=@license,active=@active,version=@version WHERE id=@id",
+                ("name",request.Name.Trim()),("license",request.LicenseRef?.Trim()),("active",request.Active),("version",version),("id",id));
+        }
+        else Execute(c,t,"INSERT INTO practitioners(id,name,license_ref,active) VALUES(@id,@name,@license,@active)",
+            ("id",id),("name",request.Name.Trim()),("license",request.LicenseRef?.Trim()),("active",request.Active));
+        Execute(c,t,"UPDATE practitioner_services SET active=false WHERE practitioner_id=@id",("id",id));
+        foreach(var service in ids)
+            Execute(c,t,"""
+                INSERT INTO practitioner_services(practitioner_id,service_id) VALUES(@p,@s)
+                ON CONFLICT(practitioner_id,service_id) DO UPDATE SET active=true
+                """,("p",id),("s",service));
+        Audit(c,t,UserId(User),created?"catalog.practitioner_created":"catalog.practitioner_updated",id,HttpContext.TraceIdentifier);
+        t.Commit();return Data(new {id,version},created?201:200);
+    }
+}
diff --git a/api/src/Telemedicina.Api/Milestone/MailDelivery.cs b/api/src/Telemedicina.Api/Milestone/MailDelivery.cs
new file mode 100644
--- /dev/null
+++ b/api/src/Telemedicina.Api/Milestone/MailDelivery.cs
@@ -0,0 +1,192 @@
+using MailKit.Net.Smtp;
+using MailKit.Security;
+using MimeKit;
+using System.Security.Cryptography;
+using System.Text;
+using static Telemedicina.Api.Milestone.Database;
+
+namespace Telemedicina.Api.Milestone;
+
+public sealed class MailSettings(IConfiguration configuration, IWebHostEnvironment environment)
+{
+    public string Mode => configuration["Mail:Mode"] ?? "development";
+    public string Host => configuration["Mail:Host"] ?? "smtp.gmail.com";
+    public int Port => configuration.GetValue("Mail:Port",587);
+    public string Username => configuration["Mail:Username"] ?? "";
+    public string Password => (configuration["Mail:Password"] ?? "").Replace(" ","");
+    public string Sender => configuration["Mail:Sender"] ?? Username;
+    public bool IsLocalTest => environment.IsDevelopment() && configuration.GetValue<bool>("Mail:AllowLocalTest")
+        && Host is "127.0.0.1" or "::1" or "localhost";
+    public string Channel => Mode=="development" ? "development" : IsLocalTest ? "smtp-test" : "smtp";
+    public int RetrySeconds => Math.Clamp(configuration.GetValue("Mail:RetrySeconds",30),1,300);
+    public byte[] PayloadKey => Convert.FromBase64String(configuration["Mail:PayloadKey"]
+        ?? throw new InvalidOperationException("Configure Mail__PayloadKey outside source control."));
+    public void Validate()
+    {
+        if(Mode is not ("development" or "smtp")) throw new InvalidOperationException("Unsupported mail mode.");
+        if(Mode=="smtp")
+        {
+            if(!MailboxAddress.TryParse(Sender,out _) || (!IsLocalTest && (string.IsNullOrEmpty(Username)||string.IsNullOrEmpty(Password))))
+                throw new InvalidOperationException("SMTP configuration is incomplete.");
+            if(PayloadKey.Length!=32) throw new InvalidOperationException("Mail__PayloadKey must encode 32 random bytes.");
+            if(!IsLocalTest && Port is not (465 or 587)) throw new InvalidOperationException("SMTP requires TLS on port 465 or 587.");
+        }
+    }
+    public string Protect(string body)
+    {
+        if(Mode=="development") return "";
+        var nonce=RandomNumberGenerator.GetBytes(12);var tag=new byte[16];
+        var plain=Encoding.UTF8.GetBytes(body);var cipher=new byte[plain.Length];
+        using var aes=new AesGcm(PayloadKey,16);
+        aes.Encrypt(nonce,plain,cipher,tag);
+        return string.Join(".",Convert.ToBase64String(nonce),Convert.ToBase64String(tag),Convert.ToBase64String(cipher));
+    }
+    public string Unprotect(string value)
+    {
+        var parts=value.Split('.');
+        var cipher=Convert.FromBase64String(parts[2]);var plain=new byte[cipher.Length];
+        using var aes=new AesGcm(PayloadKey,16);
+        aes.Decrypt(Convert.FromBase64String(parts[0]),cipher,Convert.FromBase64String(parts[1]),plain);
+        return Encoding.UTF8.GetString(plain);
+    }
+}
+
+public sealed class MailTransport(MailSettings settings)
+{
+    private async Task Connect(SmtpClient client,CancellationToken cancellation)
+    {
+        client.Timeout=15000;
+        await client.ConnectAsync(settings.Host,settings.Port,settings.IsLocalTest ? SecureSocketOptions.None :
+            settings.Port==465 ? SecureSocketOptions.SslOnConnect : SecureSocketOptions.StartTls,cancellation);
+        if(!settings.IsLocalTest || !string.IsNullOrEmpty(settings.Username))
+            await client.AuthenticateAsync(settings.Username,settings.Password,cancellation);
+    }
+    // Authentication check only: never issues SMTP MAIL FROM, RCPT TO or DATA.
+    public async Task<bool> CheckAsync(CancellationToken cancellation)
+    {
+        try
+        {
+            settings.Validate();
+            using var client=new SmtpClient();
+            await Connect(client,cancellation);
+            await client.NoOpAsync(cancellation);
+            await client.DisconnectAsync(true,cancellation);
+            return true;
+        }
+        catch(Exception) when(!cancellation.IsCancellationRequested) { return false; }
+    }
+    public async Task<(string State,string? Code)> SendAsync(Dictionary<string,object?> item,CancellationToken cancellation)
+    {
+        if(settings.Mode=="development") return ("Captured",null);
+        if(!settings.IsLocalTest && ((string)item["recipient"]!).EndsWith(".invalid",StringComparison.OrdinalIgnoreCase))
+            return ("Failed","RESERVED_TEST_DOMAIN");
+        var sendStarted=false;
+        try
+        {
+            var message=new MimeMessage();
+            message.From.Add(MailboxAddress.Parse(settings.Sender));
+            message.To.Add(MailboxAddress.Parse((string)item["recipient"]!));
+            message.Subject=(string)item["subject"]!;
+            message.MessageId=(string)item["id"]!+"@"+settings.Sender.Split('@')[1];
+            message.Body=new TextPart("plain"){Text=settings.Unprotect((string)item["payload_cipher"]!)};
+            using var client=new SmtpClient();
+            await Connect(client,cancellation);
+            sendStarted=true;
+            await client.SendAsync(message,cancellation);
+            // DATA was acknowledged. A disconnect failure must not retry an accepted message.
+            try { await client.DisconnectAsync(true,cancellation); } catch { }
+            return ("Sent",null);
+        }
+        catch(MailKit.Net.Smtp.SmtpCommandException e)
+        {
+            return ((int)e.StatusCode>=500 ? "Failed" : "Queued","SMTP_"+(int)e.StatusCode);
+        }
+        catch(MailKit.Security.AuthenticationException) { return ("Failed","SMTP_AUTH_FAILED"); }
+        catch(CryptographicException) { return ("Failed","PAYLOAD_KEY_MISMATCH"); }
+        catch(Exception) { return (sendStarted ? "Unknown" : "Queued",sendStarted ? "SMTP_ACK_UNKNOWN" : "SMTP_CONNECT_FAILED"); }
+    }
+}
+
+public sealed class MailWorker(IServiceProvider services,IConfiguration configuration,IWebHostEnvironment environment,
+    ILogger<MailWorker> logger) : BackgroundService
+{
+    protected override async Task ExecuteAsync(CancellationToken cancellation)
+    {
+        if(!environment.IsDevelopment()||!configuration.GetValue<bool>("Milestone:Enabled")) return;
+        var settings=services.GetRequiredService<MailSettings>(); settings.Validate();
+        while(!cancellation.IsCancellationRequested)
+        {
+            try { await DeliverOne(settings,cancellation); }
+            catch(OperationCanceledException) when(cancellation.IsCancellationRequested) { break; }
+            catch(Exception) { logger.LogWarning("Email worker unavailable; retrying without logging message content or credentials."); }
+            try { await Task.Delay(TimeSpan.FromSeconds(1),cancellation); }
+            catch(OperationCanceledException) { break; }
+        }
+    }
+    private async Task DeliverOne(MailSettings settings,CancellationToken cancellation)
+    {
+        var database=services.GetRequiredService<Database>();
+        using var c=database.Open();
+        using(var t=c.BeginTransaction())
+        {
+            // A crashed send might have been accepted. Never blindly re-send its lease.
+            Execute(c,t,"""
+                UPDATE email_outbox SET state='Unknown',last_error_code='LEASE_ACK_UNKNOWN',locked_until=NULL
+                WHERE channel=@channel AND state='Sending' AND locked_until<now()
+                """,("channel",settings.Channel));
+            t.Commit();
+        }
+        Dictionary<string,object?>? row;
+        var lease=Guid.NewGuid().ToString();
+        using(var t=c.BeginTransaction())
+        {
+            row=Rows(c,t,"""
+                SELECT * FROM email_outbox WHERE channel=@channel AND state='Queued' AND available_at<=now()
+                ORDER BY created_at FOR UPDATE SKIP LOCKED LIMIT 1
+                """,("channel",settings.Channel)).FirstOrDefault();
+            if(row is null) return;
+            Execute(c,t,"""
+                UPDATE email_outbox SET state='Sending',attempts=attempts+1,lease_token=@lease,
+                locked_until=now()+interval '2 minutes' WHERE id=@id
+                """,("lease",lease),("id",row["id"]));
+            t.Commit();
+        }
+        var resource=row["resource_id"] as string;
+        var userKey="mailuser:"+(string)row["user_id"]!;
+        Execute(c,null,"SELECT pg_advisory_lock(hashtextextended(@key,0))",("key",userKey));
+        if(resource is not null) Execute(c,null,"SELECT pg_advisory_lock(hashtextextended(@key,0))",("key","delivery:"+resource));
+        try
+        {
+            (string State,string? Code) result;
+            if(row["expires_at"] is DateTime expiry && expiry<=DateTime.UtcNow) result=("Expired",null);
+            else if(row["resource_version"] is int version && resource is not null &&
+                Convert.ToInt32(Scalar(c,null,"SELECT version FROM appointments WHERE id=@id",("id",resource)))!=version)
+                result=("Superseded",null);
+            else if(row["notification_id"] is not null && Scalar(c,null,"SELECT email_enabled FROM notification_preferences WHERE user_id=@u",("u",row["user_id"])) is not true)
+                result=("Superseded",null);
+            else if(!Convert.ToBoolean(Scalar(c,null,"SELECT active FROM users WHERE id=@id",("id",row["user_id"]))))
+                result=("Superseded",null);
+            else
+            {
+                using var deadline=CancellationTokenSource.CreateLinkedTokenSource(cancellation);
+                deadline.CancelAfter(TimeSpan.FromSeconds(25));
+                result=await services.GetRequiredService<MailTransport>().SendAsync(row,deadline.Token);
+            }
+            var attempts=(int)row["attempts"]!+1;
+            if(result.State=="Queued"&&attempts>=6) result=("Failed","RETRY_LIMIT");
+            var delay=Math.Min(3600,settings.RetrySeconds*(1<<Math.Min(attempts-1,6)));
+            Execute(c,null,"""
+                UPDATE email_outbox SET state=@state,last_error_code=@code,locked_until=NULL,
+                available_at=now()+make_interval(secs=>@delay),
+                sent_at=CASE WHEN @state IN ('Sent','Captured') THEN now() ELSE sent_at END,
+                payload_cipher=CASE WHEN @state IN ('Sent','Captured','Superseded','Expired','Failed') THEN '' ELSE payload_cipher END
+                WHERE id=@id AND lease_token=@lease
+                """,("state",result.State),("code",result.Code),("delay",delay),("id",row["id"]),("lease",lease));
+        }
+        finally
+        {
+            if(resource is not null) Execute(c,null,"SELECT pg_advisory_unlock(hashtextextended(@key,0))",("key","delivery:"+resource));
+            Execute(c,null,"SELECT pg_advisory_unlock(hashtextextended(@key,0))",("key",userKey));
+        }
+    }
+}
