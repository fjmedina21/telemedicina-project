+.workspace .bg-teal-700 { background:var(--brand); border-radius:10px; min-height:44px; padding:10px 16px; font-weight:600; }
+.workspace .underline { color:var(--brand); text-underline-offset:4px; }
+@media(max-width:1100px) {
+ .portal-frame { grid-template-columns:210px minmax(0,1fr); }
+ .workspace main { padding:28px 24px; }
