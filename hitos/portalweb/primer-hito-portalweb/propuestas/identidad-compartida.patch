+}
+@media(max-width:760px) {
+ .portal-frame { display:block; }
+ .sidebar { position:relative; height:auto; padding:20px 16px 12px; border-right:0; border-bottom:1px solid var(--border); }
+ .brand-link { margin:0 0 18px; }
+ .nav-caption,.sidebar-bottom { display:none; }
+ .sidebar nav { display:flex; overflow-x:auto; padding-bottom:4px; }
+ .nav-link { flex-shrink:0; padding:10px; gap:7px; font-size:12px; }
+ .nav-link svg { width:16px; }
+ .workspace-bar { min-height:52px; padding:12px 20px; }
+ .timezone { font-size:10px; }
+ .workspace main { padding:24px 16px; }
+ .workspace-footer { padding:20px 16px; }
+ .stats-grid { gap:8px; }
+ .stat-card { padding:14px 12px; }
+ .stat-card strong { font-size:25px; }
+ .stat-card span,.stat-card small { font-size:10px; }
+ .account-actions { width:100%; justify-content:space-between; }
+ .panel-toolbar { padding:18px 16px; }
+ .table-filters { width:100%; }
+ .table-filters input { flex:1; min-width:140px; }
+ .auth-header { padding:22px 20px; }
+ .auth-header .environment-tag { font-size:9px; padding:5px 7px; }
+ .auth-frame .workspace main { padding:16px 20px 40px; }
+ .login-grid { grid-template-columns:1fr; gap:28px; min-height:auto; }
+ .login-story h2 { font-size:34px; margin:12px 0; }
+ .login-story>p { font-size:14px; }
+ .login-note { display:none; }
+ .login-card { padding:24px; }
+}
+@media(prefers-reduced-motion:reduce) { *,*::before,*::after { scroll-behavior:auto!important; transition:none!important; animation:none!important; } }
 
